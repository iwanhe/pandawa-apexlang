page 210 (
    name: Items
    alias: ITEMS
    title: Items
    pageGroup: @master-data
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @app-users
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region items (
        name: Items
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select item_id, item_code, item_name, category, uom, std_price, active_yn, updated_by, updated_on
                  from apx_demo_items_v
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 211
                items: {
                    P211_ITEM_ID: \#ITEM_ID#\
                }
                clearCache: 211
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: Tidak ada data.
        }
        actionsMenu {
            subscription: false
        }

        column ITEM_ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 1
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        column ITEM_CODE (
            type: plainText
            heading {
                heading: Kode Item
            }
            layout {
                sequence: 2
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column ITEM_NAME (
            type: plainText
            heading {
                heading: Nama Item
            }
            layout {
                sequence: 3
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column CATEGORY (
            type: plainText
            heading {
                heading: Kategori
            }
            layout {
                sequence: 4
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        column UOM (
            type: plainText
            heading {
                heading: Satuan
            }
            layout {
                sequence: 5
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        column STD_PRICE (
            type: plainText
            heading {
                heading: Harga Standar
                alignment: end
            }
            layout {
                sequence: 6
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: F
            }
        )

        column ACTIVE_YN (
            type: plainText
            heading {
                heading: Aktif
            }
            layout {
                sequence: 7
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: G
            }
        )

        column UPDATED_BY (
            type: plainText
            heading {
                heading: Diubah Oleh
            }
            layout {
                sequence: 8
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: H
            }
        )

        column UPDATED_ON (
            type: plainText
            heading {
                heading: Diubah
            }
            layout {
                sequence: 9
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: I
            }
        )

        savedReport 210001 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn ITEM_CODE (
                sequence: 1
            )

            displayColumn ITEM_NAME (
                sequence: 2
            )

            displayColumn CATEGORY (
                sequence: 3
            )

            displayColumn UOM (
                sequence: 4
            )

            displayColumn STD_PRICE (
                sequence: 5
            )

            displayColumn ACTIVE_YN (
                sequence: 6
            )

            displayColumn UPDATED_BY (
                sequence: 7
            )

            displayColumn UPDATED_ON (
                sequence: 8
            )

            sort (
                column: ITEM_CODE
                sort {
                    sequence: 1
                }
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 10
            region: @items
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 211
                clearCache: 211
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @master-data
        }
    )

    dynamicAction on-dialog-closed-refresh-report (
        name: ON_DIALOG_CLOSED_REFRESH_REPORT
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @items
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @items
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)
