page 300 (
    name: Permintaan Barang
    alias: REQUESTS
    title: Permintaan Barang
    pageGroup: @transaksi
    appearance {
        pageTemplate: @/left-side-column
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @app-users
    }
    comments {
        comments:
            ```
            ## Purpose
            
            Permintaan barang dari department ke gudang, disetujui Manager (dan Director bila > 10 jt).
            
            ## When to Use
            
            Mencari, memfilter, dan membuka Permintaan Barang. Create/Edit membuka form modal di halaman 301 (request).
            
            ## AI Guidance
            
            Pola faceted search (faceted-report): facet di kolom kiri, hasil di body, dari view apx_demo_requests_v (MVC). Hak akses list app-users, create/edit requester.
            
            ## Source
            
            Generated dari app.yaml entities.REQUESTS. (list_type: faceted-report) Ubah app.yaml lalu jalankan scripts/generate.sh; jangan edit file ini.
            ```
    }

    region button-bar (
        name: Permintaan Barang
        type: staticContent
        source {
            htmlCode: <span class="u-text-body-sm u-text-muted-color"><span id="total_row_count">-</span> baris</span>
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/hero
            templateOptions: [
                #DEFAULT#
                t-HeroRegion--hideIcon
            ]
        }
        comments {
            comments:
                ```
                Intent: Judul halaman, jumlah hasil, dan tombol Create.
                Pattern role: Page header with primary action.
                ```
        }
    )

    region search (
        name: Filter
        type: facetedSearch
        source {
            filteredRegion: @results
        }
        layout {
            sequence: 10
            slot: leftColumn
        }
        appearance {
            template: @/blank-with-attributes-no-grid
            templateOptions: #DEFAULT#
        }
        comments {
            comments:
                ```
                Intent: Mempersempit Permintaan Barang berdasarkan dimensi yang bermakna.
                Pattern role: Facets (Faceted Search).
                AI guidance: Facet otomatis dari kolom enum, yn, ref, dan status; atur dengan facet: true/false per kolom di app.yaml.
                ```
        }
        settings {
            showTotalRowCount: selector
            totalRowCountSelector: #total_row_count
        }

        facet P300_SEARCH (
            type: search
            label {
                label: Cari
            }
            layout {
                sequence: 10
            }
        )

        facet P300_STATUS (
            type: checkboxGroup
            label {
                label: Status
            }
            lov {
                type: distinctValues
            }
            layout {
                sequence: 20
            }
            listEntries {
                maxDisplayedEntries: 7
                allowToExclude: false
            }
            source {
                databaseColumn: STATUS
            }
        )

        facet P300_DEPARTMENT_ID_DSP (
            type: checkboxGroup
            label {
                label: Department
            }
            lov {
                type: distinctValues
            }
            layout {
                sequence: 30
            }
            listEntries {
                maxDisplayedEntries: 7
                allowToExclude: false
            }
            source {
                databaseColumn: DEPARTMENT_ID_DSP
            }
        )

    )

    region results (
        name: Hasil Permintaan Barang
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select request_id
                      ,request_no
                      ,department_id_dsp
                      ,request_date
                      ,need_date
                      ,purpose
                      ,status
                      ,updated_by
                      ,updated_on
                  from apx_demo_requests_v
                ```
        }
        orderBy {
            type: staticValue
            orderByClause: REQUEST_NO DESC
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noUI
            ]
        }
        comments {
            comments:
                ```
                Intent: Hasil pencarian Permintaan Barang yang sudah difilter facet.
                Pattern role: Faceted search results (Classic Report).
                AI guidance: Klik kolom judul untuk membuka form. Kolom diambil dari columns di app.yaml.
                ```
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        messages {
            whenNoDataFound: Tidak ada data.
        }

        column REQUEST_ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 10
            }
        )

        column REQUEST_NO (
            reportColumnQueryId: 2
            derivedColumn: N
            type: link
            heading {
                heading: No. Permintaan Barang
            }
            layout {
                sequence: 20
            }
            link {
                target: {
                    page: 301
                    items: {
                        P301_REQUEST_ID: #REQUEST_ID#
                    }
                    clearCache: 301
                }
                linkText: #REQUEST_NO#
                linkAttributes: class="u-text-bold"
            }
        )

        column DEPARTMENT_ID_DSP (
            reportColumnQueryId: 3
            derivedColumn: N
            type: plainText
            heading {
                heading: Department
            }
            layout {
                sequence: 30
            }
        )

        column REQUEST_DATE (
            reportColumnQueryId: 4
            derivedColumn: N
            type: plainText
            heading {
                heading: Tanggal
            }
            layout {
                sequence: 40
            }
        )

        column NEED_DATE (
            reportColumnQueryId: 5
            derivedColumn: N
            type: plainText
            heading {
                heading: Dibutuhkan Tanggal
            }
            layout {
                sequence: 50
            }
        )

        column PURPOSE (
            reportColumnQueryId: 6
            derivedColumn: N
            type: plainText
            heading {
                heading: Keperluan
            }
            layout {
                sequence: 60
            }
        )

        column STATUS (
            reportColumnQueryId: 7
            derivedColumn: N
            type: plainText
            heading {
                heading: Status
            }
            layout {
                sequence: 70
            }
        )

        column UPDATED_BY (
            reportColumnQueryId: 8
            derivedColumn: N
            type: plainText
            heading {
                heading: Diubah Oleh
            }
            layout {
                sequence: 80
            }
        )

        column UPDATED_ON (
            reportColumnQueryId: 9
            derivedColumn: N
            type: plainText
            heading {
                heading: Diubah
            }
            layout {
                sequence: 90
            }
        )

    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 10
            region: @button-bar
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 301
                clearCache: 301
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @requester
        }
    )

    dynamicAction on-dialog-closed-refresh-report (
        name: ON_DIALOG_CLOSED_REFRESH_REPORT
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @results
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @results
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)
