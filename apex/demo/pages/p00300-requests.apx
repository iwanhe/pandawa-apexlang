page 300 (
    name: Permintaan Barang
    alias: REQUESTS
    title: Permintaan Barang
    pageGroup: @transaksi
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @app-users
    }
    comments {
        comments:
            ```
            ## Purpose
            
            Permintaan barang dari department ke gudang, disetujui Manager (dan Director bila > 10 jt).
            
            ## When to Use
            
            Mencari, memfilter, dan membuka Permintaan Barang. Create/Edit membuka form modal di halaman 301 (request).
            
            ## AI Guidance
            
            Pola list: Interactive Report dari view apx_demo_requests_v (MVC: region membaca view, bukan tabel). Kolom ref tampil sebagai <KOLOM>_DSP. Hak akses list app-users, create/edit requester.
            
            ## Source
            
            Generated dari app.yaml entities.REQUESTS. Ubah app.yaml lalu jalankan scripts/generate.sh; jangan edit file ini.
            ```
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region requests (
        name: Permintaan Barang
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select request_id, request_no, department_id_dsp, request_date, need_date, purpose, status, updated_by, updated_on
                  from apx_demo_requests_v
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        comments {
            comments:
                ```
                Intent: Menampilkan Permintaan Barang yang bisa dicari dan difilter.
                Pattern role: Browse list (Interactive Report).
                AI guidance: Tambah kolom lewat columns di app.yaml (list: true/false), bukan dengan mengubah query ini.
                ```
        }
        link {
            linkColumn: customTarget
            target: {
                page: 301
                items: {
                    P301_REQUEST_ID: \#REQUEST_ID#\
                }
                clearCache: 301
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: Tidak ada data.
        }
        actionsMenu {
            subscription: false
        }

        column REQUEST_ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 1
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        column REQUEST_NO (
            type: plainText
            heading {
                heading: No. Permintaan Barang
            }
            layout {
                sequence: 2
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column DEPARTMENT_ID_DSP (
            type: plainText
            heading {
                heading: Department
            }
            layout {
                sequence: 3
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column REQUEST_DATE (
            type: plainText
            heading {
                heading: Tanggal
            }
            layout {
                sequence: 4
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: D
            }
        )

        column NEED_DATE (
            type: plainText
            heading {
                heading: Dibutuhkan Tanggal
            }
            layout {
                sequence: 5
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: E
            }
        )

        column PURPOSE (
            type: plainText
            heading {
                heading: Keperluan
            }
            layout {
                sequence: 6
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: F
            }
        )

        column STATUS (
            type: plainText
            heading {
                heading: Status
            }
            layout {
                sequence: 7
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: G
            }
        )

        column UPDATED_BY (
            type: plainText
            heading {
                heading: Diubah Oleh
            }
            layout {
                sequence: 8
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: H
            }
        )

        column UPDATED_ON (
            type: plainText
            heading {
                heading: Diubah
            }
            layout {
                sequence: 9
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: I
            }
        )

        savedReport 300001 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn REQUEST_NO (
                sequence: 1
            )

            displayColumn DEPARTMENT_ID_DSP (
                sequence: 2
            )

            displayColumn REQUEST_DATE (
                sequence: 3
            )

            displayColumn NEED_DATE (
                sequence: 4
            )

            displayColumn PURPOSE (
                sequence: 5
            )

            displayColumn STATUS (
                sequence: 6
            )

            displayColumn UPDATED_BY (
                sequence: 7
            )

            displayColumn UPDATED_ON (
                sequence: 8
            )

            sort (
                column: REQUEST_NO
                sort {
                    sequence: 1
                    direction: desc
                }
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 10
            region: @requests
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 301
                clearCache: 301
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @requester
        }
    )

    dynamicAction on-dialog-closed-refresh-report (
        name: ON_DIALOG_CLOSED_REFRESH_REPORT
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @requests
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @requests
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)
