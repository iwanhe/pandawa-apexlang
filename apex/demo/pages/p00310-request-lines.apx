page 310 (
    name: Baris Permintaan
    alias: REQUEST-LINES
    title: Baris Permintaan
    pageGroup: @transaksi
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @app-users
    }
    comments {
        comments:
            ```
            ## Purpose
            
            Daftar Baris Permintaan (baris detail dari Permintaan Barang).
            
            ## When to Use
            
            Mencari, memfilter, dan membuka Baris Permintaan. Create/Edit membuka form drawer di halaman 311 (request-line).
            
            ## AI Guidance
            
            Pola list: Interactive Report dari view apx_demo_request_lines_v (MVC: region membaca view, bukan tabel). Kolom ref tampil sebagai <KOLOM>_DSP. Hak akses list app-users, create/edit requester.
            
            ## Source
            
            Generated dari app.yaml entities.REQUEST_LINES. Ubah app.yaml lalu jalankan scripts/generate.sh; jangan edit file ini.
            
            ## Requirements
            
            REQ-3.3, REQ-4.5, REQ-5.6 (lihat docs/02-frs.md dan docs/traceability.md).
            ```
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region request-lines (
        name: Baris Permintaan
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select line_id, request_id_dsp, item_id_dsp, qty, unit_price, line_amount, updated_by, updated_on
                  from apx_demo_request_lines_v
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        comments {
            comments:
                ```
                Intent: Menampilkan Baris Permintaan yang bisa dicari dan difilter.
                Pattern role: Browse list (Interactive Report).
                AI guidance: Tambah kolom lewat columns di app.yaml (list: true/false), bukan dengan mengubah query ini.
                ```
        }
        link {
            linkColumn: customTarget
            target: {
                page: 311
                items: {
                    P311_LINE_ID: \#LINE_ID#\
                }
                clearCache: 311
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: Tidak ada data.
        }
        actionsMenu {
            subscription: false
        }

        column LINE_ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 1
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        column REQUEST_ID_DSP (
            type: plainText
            heading {
                heading: No. Permintaan
            }
            layout {
                sequence: 2
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column ITEM_ID_DSP (
            type: plainText
            heading {
                heading: Item
            }
            layout {
                sequence: 3
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column QTY (
            type: plainText
            heading {
                heading: Qty
                alignment: end
            }
            layout {
                sequence: 4
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G990D99
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: D
            }
        )

        column UNIT_PRICE (
            type: plainText
            heading {
                heading: Harga Satuan
                alignment: end
            }
            layout {
                sequence: 5
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: E
            }
        )

        column LINE_AMOUNT (
            type: plainText
            heading {
                heading: Jumlah
                alignment: end
            }
            layout {
                sequence: 6
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: F
            }
        )

        column UPDATED_BY (
            type: plainText
            heading {
                heading: Diubah Oleh
            }
            layout {
                sequence: 7
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: G
            }
        )

        column UPDATED_ON (
            type: plainText
            heading {
                heading: Diubah
            }
            layout {
                sequence: 8
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: H
            }
        )

        savedReport 310001 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn REQUEST_ID_DSP (
                sequence: 1
            )

            displayColumn ITEM_ID_DSP (
                sequence: 2
            )

            displayColumn QTY (
                sequence: 3
            )

            displayColumn UNIT_PRICE (
                sequence: 4
            )

            displayColumn LINE_AMOUNT (
                sequence: 5
            )

            displayColumn UPDATED_BY (
                sequence: 6
            )

            displayColumn UPDATED_ON (
                sequence: 7
            )

            sort (
                column: LINE_ID
                sort {
                    sequence: 1
                }
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 10
            region: @request-lines
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 311
                clearCache: 311
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @requester
        }
    )

    dynamicAction on-dialog-closed-refresh-report (
        name: ON_DIALOG_CLOSED_REFRESH_REPORT
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @request-lines
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @request-lines
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)
