page 301 (
    name: Permintaan Barang
    alias: REQUEST
    title: Permintaan Barang
    pageGroup: @transaksi
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        chained: false
        resizable: true
    }
    security {
        authorizationScheme: @requester
    }
    comments {
        comments:
            ```
            ## Purpose
            
            Permintaan barang dari department ke gudang, disetujui Manager (dan Director bila > 10 jt).
            
            ## When to Use
            
            Dibuka dari halaman list 300 (requests) untuk create/edit satu record.
            
            ## AI Guidance
            
            Dokumen ber-approval REQ: DRAFT -> Submit for Approval -> APPROVED/REJECTED. Kolom DEPARTMENT_ID, PURPOSE, NEED_DATE terkunci setelah approval. Logika ada di apx_demo_approval_pkg dan trigger, bukan di halaman.
            
            ## Source
            
            Generated dari app.yaml entities.REQUESTS (form_style: modal). Ubah app.yaml lalu jalankan scripts/generate.sh; jangan edit file ini.
            
            ## Requirements
            
            REQ-3.3, REQ-4.4, REQ-5.1, REQ-5.2, REQ-5.3, REQ-5.4, REQ-5.5, REQ-5.6, REQ-5.7, REQ-5.8, REQ-5.9, REQ-7.2, REQ-7.3 (lihat docs/02-frs.md dan docs/traceability.md).
            ```
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region requests (
        name: Permintaan Barang
        type: form
        source {
            location: localDatabase
            tableName: APX_DEMO_REQUESTS
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        comments {
            comments:
                ```
                Intent: Membuat dan mengubah satu record Permintaan Barang.
                Pattern role: Single-record form (modal).
                AI guidance: Validasi bisnis ada di trigger apx_demo_requests_trg dan package; item ini hanya UI. Status hanya berubah lewat approval engine.
                ```
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P301_REQUEST_ID (
        type: hidden
        layout {
            sequence: 5
            region: @requests
            slot: regionBody
        }
        source {
            formRegion: @requests
            column: REQUEST_ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P301_REQUEST_NO (
        type: displayOnly
        label {
            label: No. Permintaan Barang
            alignment: right
        }
        settings {
            sendOnPageSubmit: false
        }
        layout {
            sequence: 10
            region: @requests
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @requests
            column: REQUEST_NO
            dataType: varchar2
            queryOnly: true
        }
    )

    pageItem P301_STATUS (
        type: selectList
        label {
            label: Status
            alignment: right
        }
        lov {
            type: sharedComponent
            lov: @requests-status
            displayExtraValues: true
            displayNullValue: true
            nullDisplayValue: - Pilih -
        }
        layout {
            sequence: 15
            region: @requests
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            formRegion: @requests
            column: STATUS
            dataType: varchar2
        }
        default {
            type: static
            staticValue: DRAFT
        }
        readOnly {
            type: expression
            plsqlExpression: nvl(:P301_STATUS,'DRAFT') not in ('APPROVED','FULFILLED','CLOSED')
        }
        help {
            inlineHelpText: Status operasional setelah approved. Approval lewat Submit for Approval.
        }
    )

    pageItem P301_DEPARTMENT_ID (
        type: selectList
        label {
            label: Department
            alignment: right
        }
        lov {
            type: sharedComponent
            lov: @departments
            displayExtraValues: true
            displayNullValue: true
            nullDisplayValue: - Pilih -
        }
        layout {
            sequence: 25
            region: @requests
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @requests
            column: DEPARTMENT_ID
            dataType: number
        }
        readOnly {
            type: expression
            plsqlExpression: not (nvl(:P301_STATUS,'DRAFT') in ('DRAFT','REJECTED'))
        }
    )

    pageItem P301_REQUEST_DATE (
        type: datePicker
        label {
            label: Tanggal
            alignment: right
        }
        layout {
            sequence: 35
            region: @requests
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @requests
            column: REQUEST_DATE
            dataType: date
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue: select trunc(sysdate) from dual
        }
    )

    pageItem P301_NEED_DATE (
        type: datePicker
        label {
            label: Dibutuhkan Tanggal
            alignment: right
        }
        layout {
            sequence: 45
            region: @requests
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        source {
            formRegion: @requests
            column: NEED_DATE
            dataType: date
        }
        readOnly {
            type: expression
            plsqlExpression: not (nvl(:P301_STATUS,'DRAFT') in ('DRAFT','REJECTED'))
        }
    )

    pageItem P301_PURPOSE (
        type: textField
        label {
            label: Keperluan
            alignment: right
        }
        layout {
            sequence: 55
            region: @requests
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 60
        }
        validation {
            valueRequired: true
            maxLength: 300
        }
        source {
            formRegion: @requests
            column: PURPOSE
            dataType: varchar2
        }
        readOnly {
            type: expression
            plsqlExpression: not (nvl(:P301_STATUS,'DRAFT') in ('DRAFT','REJECTED'))
        }
    )

    pageItem P301_NOTES (
        type: textarea
        label {
            label: Catatan
            alignment: right
        }
        layout {
            sequence: 65
            region: @requests
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 60
            height: 3
        }
        validation {
            maxLength: 1000
        }
        source {
            formRegion: @requests
            column: NOTES
            dataType: varchar2
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--simple
            ]
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P301_REQUEST_ID is not null and nvl(:P301_STATUS,'DRAFT') = 'DRAFT'
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P301_REQUEST_ID is not null and nvl(:P301_STATUS,'DRAFT') not in ('SUBMITTED','CANCELLED','CLOSED')
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P301_REQUEST_ID is null
        }
    )

    button submit (
        buttonName: SUBMIT
        label: Submit for Approval
        layout {
            sequence: 50
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
            requiresConfirmation: true
        }
        confirmation {
            message: Ajukan dokumen ini untuk approval? Setelah diajukan dokumen terkunci.
            style: information
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P301_REQUEST_ID is not null and nvl(:P301_STATUS,'DRAFT') in ('DRAFT','REJECTED')
        }
    )

    dynamicAction on-click-cancel-close-dialog (
        name: ON_CLICK_CANCEL_CLOSE_DIALOG
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation check-requests-1 (
        name: NEED_DATE_AFTER_REQUEST_DATE
        execution {
            sequence: 10
        }
        validation {
            type: expression
            plsqlExpression: :P301_NEED_DATE is null or :P301_NEED_DATE >= :P301_REQUEST_DATE
        }
        error {
            errorMessage: Tanggal dibutuhkan tidak boleh sebelum tanggal permintaan.
            displayLocation: inlineWithFieldAndInNotification
            associatedItem: @P301_NEED_DATE
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: SAVE,CREATE,SUBMIT
        }
    )

    process init-requests-form (
        name: INIT_REQUESTS_FORM
        type: formInitialization
        formRegion: @requests
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 900301001
        }
    )

    process save-requests (
        name: SAVE_REQUESTS
        type: formAutoRowProcessing
        formRegion: @requests
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 900301002
        }
    )

    process call-submit-requests (
        name: CALL_SUBMIT_REQUESTS
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                apx_demo_approval_pkg.submit(p_doc_type => 'REQ', p_doc_id => :P301_REQUEST_ID);
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Dokumen diajukan untuk approval.
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
        advanced {
            executionMappingIdentifier: 900301003
        }
    )

    process close-dialog (
        name: CLOSE_DIALOG
        type: closeDialog
        settings {
            showSuccessMessages: true
        }
        execution {
            sequence: 50
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: DELETE,SAVE,CREATE,SUBMIT
        }
        advanced {
            executionMappingIdentifier: 900301004
        }
    )

)
