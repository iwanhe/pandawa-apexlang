page 211 (
    name: Item
    alias: ITEM
    title: Item
    pageGroup: @master-data
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
    }
    security {
        authorizationScheme: @master-data
    }
    comments {
        comments:
            ```
            ## Purpose
            
            Form Item.
            
            ## When to Use
            
            Dibuka dari halaman list 210 (items) untuk create/edit satu record.
            
            ## AI Guidance
            
            Form pendek; simpan dengan Create/Apply Changes. Logika validasi di database (trigger/constraint).
            
            ## Source
            
            Generated dari app.yaml entities.ITEMS (form_style: drawer). Ubah app.yaml lalu jalankan scripts/generate.sh; jangan edit file ini.
            
            ## Requirements
            
            REQ-3.2, REQ-4.2, REQ-4.3, REQ-7.1 (lihat docs/02-frs.md dan docs/traceability.md).
            ```
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region items (
        name: Item
        type: form
        source {
            location: localDatabase
            tableName: APX_DEMO_ITEMS
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        comments {
            comments:
                ```
                Intent: Membuat dan mengubah satu record Item.
                Pattern role: Single-record form (drawer).
                AI guidance: Validasi bisnis ada di trigger apx_demo_items_trg dan package; item ini hanya UI.
                ```
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P211_ITEM_ID (
        type: hidden
        layout {
            sequence: 5
            region: @items
            slot: regionBody
        }
        source {
            formRegion: @items
            column: ITEM_ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P211_ITEM_CODE (
        type: textField
        label {
            label: Kode Item
            alignment: right
        }
        layout {
            sequence: 15
            region: @items
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 30
        }
        source {
            formRegion: @items
            column: ITEM_CODE
            dataType: varchar2
        }
    )

    pageItem P211_ITEM_NAME (
        type: textField
        label {
            label: Nama Item
            alignment: right
        }
        layout {
            sequence: 25
            region: @items
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 200
        }
        source {
            formRegion: @items
            column: ITEM_NAME
            dataType: varchar2
        }
    )

    pageItem P211_CATEGORY (
        type: selectList
        label {
            label: Kategori
            alignment: right
        }
        lov {
            type: sharedComponent
            lov: @items-category
            displayExtraValues: true
            displayNullValue: true
            nullDisplayValue: - Pilih -
        }
        layout {
            sequence: 35
            region: @items
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @items
            column: CATEGORY
            dataType: varchar2
        }
    )

    pageItem P211_UOM (
        type: textField
        label {
            label: Satuan
            alignment: right
        }
        layout {
            sequence: 45
            region: @items
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 10
        }
        source {
            formRegion: @items
            column: UOM
            dataType: varchar2
        }
    )

    pageItem P211_STD_PRICE (
        type: numberField
        label {
            label: Harga Standar
            alignment: right
        }
        settings {
            numberAlignment: end
            virtualKeyboard: decimal
            minValue: 0
        }
        layout {
            sequence: 55
            region: @items
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @items
            column: STD_PRICE
            dataType: number
        }
        default {
            type: static
            staticValue: 0
        }
    )

    pageItem P211_ACTIVE_YN (
        type: selectList
        label {
            label: Aktif
            alignment: right
        }
        lov {
            type: sharedComponent
            lov: @yes-no
            displayExtraValues: true
            displayNullValue: true
            nullDisplayValue: - Pilih -
        }
        layout {
            sequence: 65
            region: @items
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            formRegion: @items
            column: ACTIVE_YN
            dataType: varchar2
        }
        default {
            type: static
            staticValue: Y
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--simple
            ]
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P211_ITEM_ID is not null
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P211_ITEM_ID is not null
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P211_ITEM_ID is null
        }
    )

    dynamicAction on-click-cancel-close-dialog (
        name: ON_CLICK_CANCEL_CLOSE_DIALOG
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process init-items-form (
        name: INIT_ITEMS_FORM
        type: formInitialization
        formRegion: @items
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 900211001
        }
    )

    process save-items (
        name: SAVE_ITEMS
        type: formAutoRowProcessing
        formRegion: @items
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 900211002
        }
    )

    process close-dialog (
        name: CLOSE_DIALOG
        type: closeDialog
        settings {
            showSuccessMessages: true
        }
        execution {
            sequence: 50
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: DELETE,SAVE,CREATE
        }
        advanced {
            executionMappingIdentifier: 900211003
        }
    )

)
