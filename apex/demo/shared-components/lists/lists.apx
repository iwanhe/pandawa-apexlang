list navigation-bar (
    name: Navigation Bar

    entry --- (
        label: ---
        layout {
            sequence: 20
            parentEntry: @app-user
        }
        link {
            target: {
                type: url
                url: separator
            }
        }
        serverSideCondition {
            type: userIsAuthenticated
        }
    )

    entry app-user (
        label: &APP_USER.
        icon {
            imageIconCssClasses: fa-user
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                type: url
                url: #
            }
        }
        userDefinedAttributes {
            2: has-username
        }
    )

    entry sign-out (
        label: Sign Out
        icon {
            imageIconCssClasses: fa-sign-out
        }
        layout {
            sequence: 30
            parentEntry: @app-user
        }
        link {
            target: {
                type: url
                url: &LOGOUT_URL.
            }
        }
        serverSideCondition {
            type: userIsAuthenticated
        }
    )

)

list navigation-menu (
    name: Navigation Menu

    entry home (
        label: Home
        icon {
            imageIconCssClasses: fa-home
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                page: 100
            }
        }
    )

    entry approval-inbox (
        label: Approval Inbox
        icon {
            imageIconCssClasses: fa-check-square-o
        }
        layout {
            sequence: 20
        }
        link {
            target: {
                page: 190
            }
        }
    )

    entry grp-master-data (
        label: Master Data
        icon {
            imageIconCssClasses: fa-table
        }
        layout {
            sequence: 30
        }
        link {
            target: {
                page: 200
            }
        }
    )

    entry departments (
        label: Departments
        icon {
            imageIconCssClasses: fa-building-o
        }
        layout {
            sequence: 40
            parentEntry: @grp-master-data
        }
        link {
            target: {
                page: 200
            }
        }
    )

    entry items (
        label: Items
        icon {
            imageIconCssClasses: fa-tag
        }
        layout {
            sequence: 50
            parentEntry: @grp-master-data
        }
        link {
            target: {
                page: 210
            }
        }
    )

    entry grp-transaksi (
        label: Transaksi
        icon {
            imageIconCssClasses: fa-exchange
        }
        layout {
            sequence: 60
        }
        link {
            target: {
                page: 300
            }
        }
    )

    entry requests (
        label: Permintaan Barang
        icon {
            imageIconCssClasses: fa-file-text-o
        }
        layout {
            sequence: 70
            parentEntry: @grp-transaksi
        }
        link {
            target: {
                page: 300
            }
        }
    )

    entry request-lines (
        label: Baris Permintaan
        icon {
            imageIconCssClasses: fa-list
        }
        layout {
            sequence: 80
            parentEntry: @grp-transaksi
        }
        link {
            target: {
                page: 310
            }
        }
    )

    entry grp-reports (
        label: Reports
        icon {
            imageIconCssClasses: fa-bar-chart
        }
        layout {
            sequence: 90
        }
        link {
            target: {
                page: 400
            }
        }
    )

    entry rekap-permintaan (
        label: Rekap Permintaan
        icon {
            imageIconCssClasses: fa-bar-chart
        }
        layout {
            sequence: 100
            parentEntry: @grp-reports
        }
        link {
            target: {
                page: 400
            }
        }
    )

    entry grp-administration (
        label: Administration
        icon {
            imageIconCssClasses: fa-gear
        }
        layout {
            sequence: 110
        }
        link {
            target: {
                page: 500
            }
        }
        security {
            authorizationScheme: @admin-rights
        }
    )

    entry users-roles (
        label: Users & Roles
        icon {
            imageIconCssClasses: fa-user-secret
        }
        layout {
            sequence: 120
            parentEntry: @grp-administration
        }
        link {
            target: {
                page: 500
            }
        }
        security {
            authorizationScheme: @admin-rights
        }
    )

    entry document-types (
        label: Document Types & Approval
        icon {
            imageIconCssClasses: fa-sliders
        }
        layout {
            sequence: 130
            parentEntry: @grp-administration
        }
        link {
            target: {
                page: 510
            }
        }
        security {
            authorizationScheme: @admin-rights
        }
    )

)
