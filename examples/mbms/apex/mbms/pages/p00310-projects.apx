page 310 (
    name: Projects
    alias: PROJECTS
    title: Projects
    pageGroup: @engineering
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @app-users
    }
    comments {
        comments:
            ```
            ## Purpose
            
            Daftar Projects (dokumen ber-approval Project Budget).
            
            ## When to Use
            
            Mencari, memfilter, dan membuka Projects. Create/Edit membuka form modal di halaman 311 (project).
            
            ## AI Guidance
            
            Pola list: Interactive Report dari view apx_mbms_projects_v (MVC: region membaca view, bukan tabel). Kolom ref tampil sebagai <KOLOM>_DSP. Hak akses list app-users, create/edit engineering.
            
            ## Source
            
            Generated dari app.yaml entities.PROJECTS. Ubah app.yaml lalu jalankan scripts/generate.sh; jangan edit file ini.
            ```
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region projects (
        name: Projects
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select project_id, project_no, project_name, project_type, customer_id_dsp, contract_value, retention_pct, start_date, end_date, progress_pct, project_manager, status, updated_by, updated_on
                  from apx_mbms_projects_v
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        comments {
            comments:
                ```
                Intent: Menampilkan Projects yang bisa dicari dan difilter.
                Pattern role: Browse list (Interactive Report).
                AI guidance: Tambah kolom lewat columns di app.yaml (list: true/false), bukan dengan mengubah query ini.
                ```
        }
        link {
            linkColumn: customTarget
            target: {
                page: 311
                items: {
                    P311_PROJECT_ID: \#PROJECT_ID#\
                }
                clearCache: 311
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: Tidak ada data.
        }
        actionsMenu {
            subscription: false
        }

        column PROJECT_ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 1
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        column PROJECT_NO (
            type: plainText
            heading {
                heading: No. Project Budget
            }
            layout {
                sequence: 2
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column PROJECT_NAME (
            type: plainText
            heading {
                heading: Nama Proyek
            }
            layout {
                sequence: 3
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column PROJECT_TYPE (
            type: plainText
            heading {
                heading: Tipe
            }
            layout {
                sequence: 4
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        column CUSTOMER_ID_DSP (
            type: plainText
            heading {
                heading: Customer
            }
            layout {
                sequence: 5
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        column CONTRACT_VALUE (
            type: plainText
            heading {
                heading: Nilai Kontrak
                alignment: end
            }
            layout {
                sequence: 6
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: F
            }
        )

        column RETENTION_PCT (
            type: plainText
            heading {
                heading: Retensi (%)
                alignment: end
            }
            layout {
                sequence: 7
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: G
            }
        )

        column START_DATE (
            type: plainText
            heading {
                heading: Mulai
            }
            layout {
                sequence: 8
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: H
            }
        )

        column END_DATE (
            type: plainText
            heading {
                heading: Target Selesai
            }
            layout {
                sequence: 9
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: I
            }
        )

        column PROGRESS_PCT (
            type: plainText
            heading {
                heading: Progres (%)
                alignment: end
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: J
            }
        )

        column PROJECT_MANAGER (
            type: plainText
            heading {
                heading: Project Manager
            }
            layout {
                sequence: 11
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: K
            }
        )

        column STATUS (
            type: plainText
            heading {
                heading: Status
            }
            layout {
                sequence: 12
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: L
            }
        )

        column UPDATED_BY (
            type: plainText
            heading {
                heading: Diubah Oleh
            }
            layout {
                sequence: 13
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: M
            }
        )

        column UPDATED_ON (
            type: plainText
            heading {
                heading: Diubah
            }
            layout {
                sequence: 14
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: N
            }
        )

        savedReport 310001 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn PROJECT_NO (
                sequence: 1
            )

            displayColumn PROJECT_NAME (
                sequence: 2
            )

            displayColumn PROJECT_TYPE (
                sequence: 3
            )

            displayColumn CUSTOMER_ID_DSP (
                sequence: 4
            )

            displayColumn CONTRACT_VALUE (
                sequence: 5
            )

            displayColumn RETENTION_PCT (
                sequence: 6
            )

            displayColumn START_DATE (
                sequence: 7
            )

            displayColumn END_DATE (
                sequence: 8
            )

            displayColumn PROGRESS_PCT (
                sequence: 9
            )

            displayColumn PROJECT_MANAGER (
                sequence: 10
            )

            displayColumn STATUS (
                sequence: 11
            )

            displayColumn UPDATED_BY (
                sequence: 12
            )

            displayColumn UPDATED_ON (
                sequence: 13
            )

            sort (
                column: PROJECT_NO
                sort {
                    sequence: 1
                    direction: desc
                }
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 10
            region: @projects
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 311
                clearCache: 311
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @engineering
        }
    )

    dynamicAction on-dialog-closed-refresh-report (
        name: ON_DIALOG_CLOSED_REFRESH_REPORT
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @projects
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @projects
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)
