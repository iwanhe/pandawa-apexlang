page 100 (
    name: Home
    alias: HOME
    title: Home
    pageGroup: @home
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @app-users
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    comments {
        comments:
            ```
            ## Purpose
            
            Ringkasan kondisi aplikasi: KPI dan chart utama.
            
            ## When to Use
            
            Halaman pertama setelah login; titik awal navigasi.
            
            ## AI Guidance
            
            Pola dashboard: metric card di atas (2-4 KPI sebanding), chart dua kolom di bawah. KPI dari view apx_mbms_dash_kpi_v (satu baris per KPI).
            
            ## Source
            
            Generated dari app.yaml dashboard. Ubah app.yaml lalu jalankan scripts/generate.sh; jangan edit file ini.
            ```
    }

    region app-name (
        name: Home
        title: MBMS Dashboard
        type: staticContent
        source {
            htmlCode: Satu sistem untuk Printing dan Engineering di atas shared core. MVP sandbox - data dummy.
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/hero
            templateOptions: #DEFAULT#
        }
        image {
            fileUrl: #APP_FILES#icons/app-icon-512.png
        }
        comments {
            comments:
                ```
                Intent: Judul dan konteks singkat aplikasi.
                Pattern role: Dashboard header.
                AI guidance: Ringkas; jangan dipakai untuk instruksi panjang.
                ```
        }
    )

    region kpi (
        name: Ringkasan
        type: themeTemplateComponent/metricCard
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select seq, icon, label, metric_value
                  from apx_mbms_dash_kpi_v
                ```
        }
        orderBy {
            type: staticValue
            orderByClause: SEQ
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/blank-with-attributes-no-grid
            templateOptions: [
                #DEFAULT#
                margin-bottom-md
            ]
        }
        accessibility {
            landmarkType: region
        }
        comments {
            comments:
                ```
                Intent: KPI utama untuk dipindai cepat.
                Pattern role: KPI summary (Metric Card).
                AI guidance: Pakai 2-4 KPI yang sebanding; ubah lewat dashboard.kpis (label, sql, icon) di app.yaml.
                ```
        }
        componentAppearance {
            display: report
        }
        settings {
            metric: &METRIC_VALUE.
            metricCssClasses: u-text-subheading-md
            meta: &LABEL.
            layout: 4Columns
        }
        plugin-avatar {
            displayAvatar: true
            icon: &ICON.
            style: subtle
            position: inline
        }

        column SEQ (
            layout {
                sequence: 10
            }
            source {
                databaseColumn: SEQ
                dataType: number
            }
        )

        column ICON (
            layout {
                sequence: 20
            }
            source {
                databaseColumn: ICON
                dataType: varchar2
            }
        )

        column LABEL (
            layout {
                sequence: 30
            }
            source {
                databaseColumn: LABEL
                dataType: varchar2
            }
        )

        column METRIC_VALUE (
            layout {
                sequence: 40
            }
            source {
                databaseColumn: METRIC_VALUE
                dataType: number
            }
            appearance {
                formatMask: 999G999G999G999G990
            }
        )

    )

    region chart-1 (
        name: Job Order per Status
        type: chart
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        comments {
            comments:
                ```
                Intent: Visualisasi Job Order per Status.
                Pattern role: Dashboard chart (pie).
                AI guidance: Data dari view apx_mbms_dash_c1_s*_v (kolom LABEL, VALUE); ubah sql-nya di dashboard.charts app.yaml.
                ```
        }
        chart {
            type: pie
        }
        performance {
            lazyLoading: false
        }
        value {
            format: decimal
            decimalPlaces: 0
        }
        legend {
            show: false
        }

        series series-1 (
            name: Job Orders
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select label, value
                      from apx_mbms_dash_c1_s1_v
                    ```
            }
            columnMapping {
                label: LABEL
                value: VALUE
            }
            label {
                show: true
            }
            performance {
                maxRowsToProcess: 50
            }
        )

    )

    region chart-2 (
        name: Nilai Stok per Gudang
        type: chart
        layout {
            sequence: 50
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        comments {
            comments:
                ```
                Intent: Visualisasi Nilai Stok per Gudang.
                Pattern role: Dashboard chart (bar).
                AI guidance: Data dari view apx_mbms_dash_c2_s*_v (kolom LABEL, VALUE); ubah sql-nya di dashboard.charts app.yaml.
                ```
        }
        performance {
            lazyLoading: false
        }
        legend {
            show: false
        }

        series series-1 (
            name: Nilai Stok
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select label, value
                      from apx_mbms_dash_c2_s1_v
                    ```
            }
            columnMapping {
                label: LABEL
                value: VALUE
            }
            label {
                show: false
            }
            performance {
                maxRowsToProcess: 50
            }
        )

        axis x (
            name: x
            majorTicks {
                show: auto
            }
        )

        axis y (
            name: y
            value {
                format: decimal
                decimalPlaces: 0
            }
            majorTicks {
                show: auto
            }
        )

    )

    region chart-3 (
        name: Proyek: Budget vs Aktual
        type: chart
        layout {
            sequence: 60
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        comments {
            comments:
                ```
                Intent: Visualisasi Proyek: Budget vs Aktual.
                Pattern role: Dashboard chart (bar).
                AI guidance: Data dari view apx_mbms_dash_c3_s*_v (kolom LABEL, VALUE); ubah sql-nya di dashboard.charts app.yaml.
                ```
        }
        performance {
            lazyLoading: false
        }
        legend {
            show: true
        }

        series series-1 (
            name: Budget
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select label, value
                      from apx_mbms_dash_c3_s1_v
                    ```
            }
            columnMapping {
                label: LABEL
                value: VALUE
            }
            label {
                show: false
            }
            performance {
                maxRowsToProcess: 50
            }
        )

        series series-2 (
            name: Aktual
            execution {
                sequence: 20
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select label, value
                      from apx_mbms_dash_c3_s2_v
                    ```
            }
            columnMapping {
                label: LABEL
                value: VALUE
            }
            label {
                show: false
            }
            performance {
                maxRowsToProcess: 50
            }
        )

        axis x (
            name: x
            majorTicks {
                show: auto
            }
        )

        axis y (
            name: y
            value {
                format: decimal
                decimalPlaces: 0
            }
            majorTicks {
                show: auto
            }
        )

    )

    region chart-4 (
        name: Job: HPP Estimasi vs Aktual
        type: chart
        layout {
            sequence: 70
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        comments {
            comments:
                ```
                Intent: Visualisasi Job: HPP Estimasi vs Aktual.
                Pattern role: Dashboard chart (bar).
                AI guidance: Data dari view apx_mbms_dash_c4_s*_v (kolom LABEL, VALUE); ubah sql-nya di dashboard.charts app.yaml.
                ```
        }
        performance {
            lazyLoading: false
        }
        legend {
            show: true
        }

        series series-1 (
            name: Estimasi
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select label, value
                      from apx_mbms_dash_c4_s1_v
                    ```
            }
            columnMapping {
                label: LABEL
                value: VALUE
            }
            label {
                show: false
            }
