page 500 (
    name: Users & Roles
    alias: USERS-ROLES
    title: Users & Roles
    pageGroup: @administration
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @admin-rights
    }
    help {
        helpText: Selama belum ada user ber-role ADMIN, semua user dianggap ADMIN (bootstrap).
    }
    comments {
        comments:
            ```
            ## Purpose
            
            Mengatur role per user APEX.
            
            ## When to Use
            
            Admin mendaftarkan user dan role-nya.
            
            ## AI Guidance
            
            Otorisasi dibaca apx_mbms_sec_pkg dari apx_mbms_user_roles. Bootstrap berakhir saat ADMIN pertama terdaftar.
            
            ## Source
            
            Halaman inti template (core module), bukan dari entities. Ubah app.yaml lalu jalankan scripts/generate.sh; jangan edit file ini.
            ```
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region users-roles (
        name: Users & Roles
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select user_role_id, username, role_code, role_name, created_by, created_on
                  from apx_mbms_user_roles_v
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        comments {
            comments:
                ```
                Intent: Daftar user dan role.
                Pattern role: Admin list (Interactive Report).
                ```
        }
        link {
            linkColumn: customTarget
            target: {
                page: 501
                items: {
                    P501_USER_ROLE_ID: \#USER_ROLE_ID#\
                }
                clearCache: 501
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: Tidak ada data.
        }
        actionsMenu {
            subscription: false
        }

        column USER_ROLE_ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 1
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        column USERNAME (
            type: plainText
            heading {
                heading: Username
            }
            layout {
                sequence: 2
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column ROLE_CODE (
            type: plainText
            heading {
                heading: Role
            }
            layout {
                sequence: 3
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column ROLE_NAME (
            type: plainText
            heading {
                heading: Nama Role
            }
            layout {
                sequence: 4
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        column CREATED_BY (
            type: plainText
            heading {
                heading: Dibuat Oleh
            }
            layout {
                sequence: 5
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        column CREATED_ON (
            type: plainText
            heading {
                heading: Dibuat
            }
            layout {
                sequence: 6
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: F
            }
        )

        savedReport 500001 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn USERNAME (
                sequence: 1
            )

            displayColumn ROLE_CODE (
                sequence: 2
            )

            displayColumn ROLE_NAME (
                sequence: 3
            )

            displayColumn CREATED_BY (
                sequence: 4
            )

            displayColumn CREATED_ON (
                sequence: 5
            )

            sort (
                column: USERNAME
                sort {
                    sequence: 1
                }
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 10
            region: @users-roles
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 501
                clearCache: 501
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction on-dialog-closed-refresh-report (
        name: ON_DIALOG_CLOSED_REFRESH_REPORT
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @users-roles
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @users-roles
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)
