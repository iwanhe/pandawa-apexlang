page 210 (
    name: Customers
    alias: CUSTOMERS
    title: Customers
    pageGroup: @master-data
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @app-users
    }
    comments {
        comments:
            ```
            ## Purpose
            
            Daftar Customers (master data).
            
            ## When to Use
            
            Mencari, memfilter, dan membuka Customers. Create/Edit membuka form modal di halaman 211 (customer).
            
            ## AI Guidance
            
            Pola list: Interactive Report dari view apx_mbms_customers_v (MVC: region membaca view, bukan tabel). Kolom ref tampil sebagai <KOLOM>_DSP. Hak akses list app-users, create/edit master-data.
            
            ## Source
            
            Generated dari app.yaml entities.CUSTOMERS. Ubah app.yaml lalu jalankan scripts/generate.sh; jangan edit file ini.
            ```
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region customers (
        name: Customers
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select customer_id, customer_code, customer_name, npwp, nitku, city, contact_person, phone, email, payment_term_days, active_yn, updated_by, updated_on
                  from apx_mbms_customers_v
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        comments {
            comments:
                ```
                Intent: Menampilkan Customers yang bisa dicari dan difilter.
                Pattern role: Browse list (Interactive Report).
                AI guidance: Tambah kolom lewat columns di app.yaml (list: true/false), bukan dengan mengubah query ini.
                ```
        }
        link {
            linkColumn: customTarget
            target: {
                page: 211
                items: {
                    P211_CUSTOMER_ID: \#CUSTOMER_ID#\
                }
                clearCache: 211
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: Tidak ada data.
        }
        actionsMenu {
            subscription: false
        }

        column CUSTOMER_ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 1
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        column CUSTOMER_CODE (
            type: plainText
            heading {
                heading: Kode
            }
            layout {
                sequence: 2
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column CUSTOMER_NAME (
            type: plainText
            heading {
                heading: Nama Customer
            }
            layout {
                sequence: 3
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column NPWP (
            type: plainText
            heading {
                heading: NPWP
            }
            layout {
                sequence: 4
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        column NITKU (
            type: plainText
            heading {
                heading: NITKU
            }
            layout {
                sequence: 5
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        column CITY (
            type: plainText
            heading {
                heading: Kota
            }
            layout {
                sequence: 6
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: F
            }
        )

        column CONTACT_PERSON (
            type: plainText
            heading {
                heading: Contact Person
            }
            layout {
                sequence: 7
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: G
            }
        )

        column PHONE (
            type: plainText
            heading {
                heading: Telepon
            }
            layout {
                sequence: 8
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: H
            }
        )

        column EMAIL (
            type: plainText
            heading {
                heading: Email
            }
            layout {
                sequence: 9
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: I
            }
        )

        column PAYMENT_TERM_DAYS (
            type: plainText
            heading {
                heading: TOP (hari)
                alignment: end
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: J
            }
        )

        column ACTIVE_YN (
            type: plainText
            heading {
                heading: Aktif
            }
            layout {
                sequence: 11
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: K
            }
        )

        column UPDATED_BY (
            type: plainText
            heading {
                heading: Diubah Oleh
            }
            layout {
                sequence: 12
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: L
            }
        )

        column UPDATED_ON (
            type: plainText
            heading {
                heading: Diubah
            }
            layout {
                sequence: 13
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: M
            }
        )

        savedReport 210001 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CUSTOMER_CODE (
                sequence: 1
            )

            displayColumn CUSTOMER_NAME (
                sequence: 2
            )

            displayColumn NPWP (
                sequence: 3
            )

            displayColumn NITKU (
                sequence: 4
            )

            displayColumn CITY (
                sequence: 5
            )

            displayColumn CONTACT_PERSON (
                sequence: 6
            )

            displayColumn PHONE (
                sequence: 7
            )

            displayColumn EMAIL (
                sequence: 8
            )

            displayColumn PAYMENT_TERM_DAYS (
                sequence: 9
            )

            displayColumn ACTIVE_YN (
                sequence: 10
            )

            displayColumn UPDATED_BY (
                sequence: 11
            )

            displayColumn UPDATED_ON (
                sequence: 12
            )

            sort (
                column: CUSTOMER_CODE
                sort {
                    sequence: 1
                }
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 10
            region: @customers
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 211
                clearCache: 211
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @master-data
        }
    )

    dynamicAction on-dialog-closed-refresh-report (
        name: ON_DIALOG_CLOSED_REFRESH_REPORT
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @customers
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @customers
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)
