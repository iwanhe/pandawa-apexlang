page 351 (
    name: Stock Transaction
    alias: STOCK-TRANSACTION
    title: Stock Transaction
    pageGroup: @inventory
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
    }
    security {
        authorizationScheme: @warehouse
    }
    comments {
        comments:
            ```
            ## Purpose
            
            Form Stock Transaction.
            
            ## When to Use
            
            Dibuka dari halaman list 350 (stock-transactions) untuk create/edit satu record.
            
            ## AI Guidance
            
            Form pendek; simpan dengan Create/Apply Changes. Logika validasi di database (trigger/constraint).
            
            ## Source
            
            Generated dari app.yaml entities.STOCK_TXNS (form_style: drawer). Ubah app.yaml lalu jalankan scripts/generate.sh; jangan edit file ini.
            ```
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region stock-txns (
        name: Stock Transaction
        type: form
        source {
            location: localDatabase
            tableName: APX_MBMS_STOCK_TXNS
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        comments {
            comments:
                ```
                Intent: Membuat dan mengubah satu record Stock Transaction.
                Pattern role: Single-record form (drawer).
                AI guidance: Validasi bisnis ada di trigger apx_mbms_stock_txns_trg dan package; item ini hanya UI.
                ```
        }
        edit {
            enabled: true
            allowedOperations: add
        }
    )

    pageItem P351_TXN_ID (
        type: hidden
        layout {
            sequence: 5
            region: @stock-txns
            slot: regionBody
        }
        source {
            formRegion: @stock-txns
            column: TXN_ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P351_TXN_NO (
        type: displayOnly
        label {
            label: No. Transaksi
            alignment: right
        }
        settings {
            sendOnPageSubmit: false
        }
        layout {
            sequence: 15
            region: @stock-txns
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @stock-txns
            column: TXN_NO
            dataType: varchar2
            queryOnly: true
        }
    )

    pageItem P351_TXN_DATE (
        type: datePicker
        label {
            label: Tanggal
            alignment: right
        }
        layout {
            sequence: 25
            region: @stock-txns
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @stock-txns
            column: TXN_DATE
            dataType: date
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue: select trunc(sysdate) from dual
        }
    )

    pageItem P351_TXN_TYPE (
        type: selectList
        label {
            label: Tipe
            alignment: right
        }
        lov {
            type: sharedComponent
            lov: @stock-txns-txn-type
            displayExtraValues: true
            displayNullValue: true
            nullDisplayValue: - Pilih -
        }
        layout {
            sequence: 35
            region: @stock-txns
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @stock-txns
            column: TXN_TYPE
            dataType: varchar2
        }
        default {
            type: static
            staticValue: RECEIPT
        }
    )

    pageItem P351_WAREHOUSE_ID (
        type: selectList
        label {
            label: Gudang / Lokasi
            alignment: right
        }
        lov {
            type: sharedComponent
            lov: @warehouses
            displayExtraValues: true
            displayNullValue: true
            nullDisplayValue: - Pilih -
        }
        layout {
            sequence: 45
            region: @stock-txns
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @stock-txns
            column: WAREHOUSE_ID
            dataType: number
        }
    )

    pageItem P351_ITEM_ID (
        type: selectList
        label {
            label: Item
            alignment: right
        }
        lov {
            type: sharedComponent
            lov: @items
            displayExtraValues: true
            displayNullValue: true
            nullDisplayValue: - Pilih -
        }
        layout {
            sequence: 55
            region: @stock-txns
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @stock-txns
            column: ITEM_ID
            dataType: number
        }
    )

    pageItem P351_QTY (
        type: numberField
        label {
            label: Qty
            alignment: right
        }
        settings {
            numberAlignment: end
            virtualKeyboard: decimal
            minValue: 0
        }
        layout {
            sequence: 65
            region: @stock-txns
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @stock-txns
            column: QTY
            dataType: number
        }
    )

    pageItem P351_UNIT_COST (
        type: numberField
        label {
            label: Biaya Satuan
            alignment: right
        }
        settings {
            numberAlignment: end
            virtualKeyboard: decimal
            minValue: 0
        }
        layout {
            sequence: 75
            region: @stock-txns
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        source {
            formRegion: @stock-txns
            column: UNIT_COST
            dataType: number
        }
        help {
            inlineHelpText: Kosongkan untuk Issue/Return (biaya rata-rata).
        }
    )

    pageItem P351_TOTAL_COST (
        type: displayOnly
        label {
            label: Total Biaya
            alignment: right
        }
        settings {
            sendOnPageSubmit: false
        }
        layout {
            sequence: 85
            region: @stock-txns
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @stock-txns
            column: TOTAL_COST
            dataType: number
            queryOnly: true
        }
    )

    pageItem P351_JOB_ID (
        type: selectList
        label {
            label: Job Order
            alignment: right
        }
        lov {
            type: sharedComponent
            lov: @job-orders
            displayExtraValues: true
            displayNullValue: true
            nullDisplayValue: - Pilih -
        }
        layout {
            sequence: 95
            region: @stock-txns
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            formRegion: @stock-txns
            column: JOB_ID
            dataType: number
        }
    )

    pageItem P351_PROJECT_ID (
        type: selectList
        label {
            label: Proyek
            alignment: right
        }
        lov {
            type: sharedComponent
            lov: @projects
            displayExtraValues: true
            displayNullValue: true
            nullDisplayValue: - Pilih -
        }
        layout {
            sequence: 105
            region: @stock-txns
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            formRegion: @stock-txns
            column: PROJECT_ID
            dataType: number
        }
    )

    pageItem P351_WBS_ID (
        type: selectList
        label {
            label: WBS
            alignment: right
        }
        lov {
            type: sqlQuery
            sqlQuery: select wbs_code || ' - ' || wbs_name d, wbs_id r from apx_mbms_wbs where project_id = :P351_PROJECT_ID order by wbs_code
            displayExtraValues: true
            displayNullValue: true
            nullDisplayValue: - Pilih -
        }
        cascadingLov {
            parentItems: P351_PROJECT_ID
            parentRequired: false
        }
        layout {
            sequence: 115
            region: @stock-txns
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            formRegion: @stock-txns
            column: WBS_ID
            dataType: number
        }
    )

    pageItem P351_REFERENCE (
        type: textField
        label {
            label: Referensi
            alignment: right
        }
        layout {
            sequence: 125
            region: @stock-txns
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 100
        }
        source {
            formRegion: @stock-txns
            column: REFERENCE
            dataType: varchar2
        }
    )

    pageItem P351_NOTES (
        type: textField
        label {
            label: Catatan
            alignment: right
        }
        layout {
            sequence: 135
            region: @stock-txns
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 60
        }
        validation {
            maxLength: 500
        }
        source {
            formRegion: @stock-txns
            column: NOTES
            dataType: varchar2
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P351_TXN_ID is null
        }
    )

    dynamicAction on-click-cancel-close-dialog (
        name: ON_CLICK_CANCEL_CLOSE_DIALOG
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation check-stock-txns-1 (
        name: RECEIPT_COST_REQUIRED
        execution {
            sequence: 10
        }
        validation {
            type: expression
            plsqlExpression: :P351_TXN_TYPE not in ('RECEIPT', 'ADJ_IN') or :P351_UNIT_COST is not null
        }
        error {
            errorMessage: Biaya satuan wajib untuk Receipt / Adjustment (+).
            displayLocation: inlineWithFieldAndInNotification
            associatedItem: @P351_UNIT_COST
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE
        }
    )

    validation check-stock-txns-2 (
        name: ISSUE_REFERENCE_REQUIRED
        execution {
            sequence: 20
        }
        validation {
            type: expression
            plsqlExpression: :P351_TXN_TYPE not in ('ISSUE', 'RETURN') or :P351_JOB_ID is not null or :P351_PROJECT_ID is not null
        }
        error {
            errorMessage: Issue/Return wajib ke Job Order atau Proyek.
            displayLocation: inlineWithFieldAndInNotification
            associatedItem: @P351_JOB_ID
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE
        }
    )

    process init-stock-txns-form (
        name: INIT_STOCK_TXNS_FORM
        type: formInitialization
        formRegion: @stock-txns
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 900351001
        }
    )

    process save-stock-txns (
        name: SAVE_STOCK_TXNS
        type: formAutoRowProcessing
        formRegion: @stock-txns
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 900351002
        }
    )

    process close-dialog (
        name: CLOSE_DIALOG
        type: closeDialog
        settings {
            showSuccessMessages: true
        }
        execution {
            sequence: 50
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE
        }
        advanced {
            executionMappingIdentifier: 900351003
        }
    )

)
