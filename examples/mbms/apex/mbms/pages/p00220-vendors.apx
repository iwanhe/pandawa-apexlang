page 220 (
    name: Vendors
    alias: VENDORS
    title: Vendors
    pageGroup: @master-data
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @app-users
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region vendors (
        name: Vendors
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select vendor_id, vendor_code, vendor_name, vendor_type, npwp, city, phone, payment_term_days, active_yn, updated_by, updated_on
                  from apx_mbms_vendors_v
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 221
                items: {
                    P221_VENDOR_ID: \#VENDOR_ID#\
                }
                clearCache: 221
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: Tidak ada data.
        }
        actionsMenu {
            subscription: false
        }

        column VENDOR_ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 1
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        column VENDOR_CODE (
            type: plainText
            heading {
                heading: Kode
            }
            layout {
                sequence: 2
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column VENDOR_NAME (
            type: plainText
            heading {
                heading: Nama Vendor
            }
            layout {
                sequence: 3
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column VENDOR_TYPE (
            type: plainText
            heading {
                heading: Tipe
            }
            layout {
                sequence: 4
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        column NPWP (
            type: plainText
            heading {
                heading: NPWP
            }
            layout {
                sequence: 5
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        column CITY (
            type: plainText
            heading {
                heading: Kota
            }
            layout {
                sequence: 6
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: F
            }
        )

        column PHONE (
            type: plainText
            heading {
                heading: Telepon
            }
            layout {
                sequence: 7
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: G
            }
        )

        column PAYMENT_TERM_DAYS (
            type: plainText
            heading {
                heading: TOP (hari)
                alignment: end
            }
            layout {
                sequence: 8
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: H
            }
        )

        column ACTIVE_YN (
            type: plainText
            heading {
                heading: Aktif
            }
            layout {
                sequence: 9
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: I
            }
        )

        column UPDATED_BY (
            type: plainText
            heading {
                heading: Diubah Oleh
            }
            layout {
                sequence: 10
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: J
            }
        )

        column UPDATED_ON (
            type: plainText
            heading {
                heading: Diubah
            }
            layout {
                sequence: 11
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: K
            }
        )

        savedReport 220001 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn VENDOR_CODE (
                sequence: 1
            )

            displayColumn VENDOR_NAME (
                sequence: 2
            )

            displayColumn VENDOR_TYPE (
                sequence: 3
            )

            displayColumn NPWP (
                sequence: 4
            )

            displayColumn CITY (
                sequence: 5
            )

            displayColumn PHONE (
                sequence: 6
            )

            displayColumn PAYMENT_TERM_DAYS (
                sequence: 7
            )

            displayColumn ACTIVE_YN (
                sequence: 8
            )

            displayColumn UPDATED_BY (
                sequence: 9
            )

            displayColumn UPDATED_ON (
                sequence: 10
            )

            sort (
                column: VENDOR_CODE
                sort {
                    sequence: 1
                }
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 10
            region: @vendors
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 221
                clearCache: 221
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @master-data
        }
    )

    dynamicAction on-dialog-closed-refresh-report (
        name: ON_DIALOG_CLOSED_REFRESH_REPORT
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @vendors
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @vendors
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)
