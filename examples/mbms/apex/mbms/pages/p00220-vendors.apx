page 220 (
    name: Vendors
    alias: VENDORS
    title: Vendors
    pageGroup: @master-data
    appearance {
        pageTemplate: @/left-side-column
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @app-users
    }
    comments {
        comments:
            ```
            ## Purpose
            
            Daftar Vendors (master data).
            
            ## When to Use
            
            Mencari, memfilter, dan membuka Vendors. Create/Edit membuka form drawer di halaman 221 (vendor).
            
            ## AI Guidance
            
            Pola faceted search (faceted-report): facet di kolom kiri, hasil di body, dari view apx_mbms_vendors_v (MVC). Hak akses list app-users, create/edit master-data.
            
            ## Source
            
            Generated dari app.yaml entities.VENDORS. (list_type: faceted-report) Ubah app.yaml lalu jalankan scripts/generate.sh; jangan edit file ini.
            ```
    }

    region button-bar (
        name: Vendors
        type: staticContent
        source {
            htmlCode: <span class="u-text-body-sm u-text-muted-color"><span id="total_row_count">-</span> baris</span>
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/hero
            templateOptions: [
                #DEFAULT#
                t-HeroRegion--hideIcon
            ]
        }
        comments {
            comments:
                ```
                Intent: Judul halaman, jumlah hasil, dan tombol Create.
                Pattern role: Page header with primary action.
                ```
        }
    )

    region search (
        name: Filter
        type: facetedSearch
        source {
            filteredRegion: @results
        }
        layout {
            sequence: 10
            slot: leftColumn
        }
        appearance {
            template: @/blank-with-attributes-no-grid
            templateOptions: #DEFAULT#
        }
        comments {
            comments:
                ```
                Intent: Mempersempit Vendors berdasarkan dimensi yang bermakna.
                Pattern role: Facets (Faceted Search).
                AI guidance: Facet otomatis dari kolom enum, yn, ref, dan status; atur dengan facet: true/false per kolom di app.yaml.
                ```
        }
        settings {
            showTotalRowCount: selector
            totalRowCountSelector: #total_row_count
        }

        facet P220_SEARCH (
            type: search
            label {
                label: Cari
            }
            layout {
                sequence: 10
            }
        )

        facet P220_VENDOR_TYPE (
            type: checkboxGroup
            label {
                label: Tipe
            }
            lov {
                type: sharedComponent
                lov: @vendors-vendor-type
            }
            layout {
                sequence: 20
            }
            listEntries {
                maxDisplayedEntries: 7
                allowToExclude: false
            }
            source {
                databaseColumn: VENDOR_TYPE
            }
        )

        facet P220_ACTIVE_YN (
            type: checkboxGroup
            label {
                label: Aktif
            }
            lov {
                type: sharedComponent
                lov: @yes-no
            }
            layout {
                sequence: 30
            }
            listEntries {
                maxDisplayedEntries: 7
                allowToExclude: false
            }
            source {
                databaseColumn: ACTIVE_YN
            }
        )

    )

    region results (
        name: Hasil Vendors
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select vendor_id
                      ,vendor_code
                      ,vendor_name
                      ,vendor_type
                      ,npwp
                      ,city
                      ,phone
                      ,payment_term_days
                      ,active_yn
                      ,updated_by
                      ,updated_on
                  from apx_mbms_vendors_v
                ```
        }
        orderBy {
            type: staticValue
            orderByClause: VENDOR_CODE
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noUI
            ]
        }
        comments {
            comments:
                ```
                Intent: Hasil pencarian Vendors yang sudah difilter facet.
                Pattern role: Faceted search results (Classic Report).
                AI guidance: Klik kolom judul untuk membuka form. Kolom diambil dari columns di app.yaml.
                ```
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        messages {
            whenNoDataFound: Tidak ada data.
        }

        column VENDOR_ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 10
            }
        )

        column VENDOR_CODE (
            reportColumnQueryId: 2
            derivedColumn: N
            type: link
            heading {
                heading: Kode
            }
            layout {
                sequence: 20
            }
            link {
                target: {
                    page: 221
                    items: {
                        P221_VENDOR_ID: #VENDOR_ID#
                    }
                    clearCache: 221
                }
                linkText: #VENDOR_CODE#
                linkAttributes: class="u-text-bold"
            }
        )

        column VENDOR_NAME (
            reportColumnQueryId: 3
            derivedColumn: N
            type: plainText
            heading {
                heading: Nama Vendor
            }
            layout {
                sequence: 30
            }
        )

        column VENDOR_TYPE (
            reportColumnQueryId: 4
            derivedColumn: N
            type: plainText
            heading {
                heading: Tipe
            }
            layout {
                sequence: 40
            }
        )

        column NPWP (
            reportColumnQueryId: 5
            derivedColumn: N
            type: plainText
            heading {
                heading: NPWP
            }
            layout {
                sequence: 50
            }
        )

        column CITY (
            reportColumnQueryId: 6
            derivedColumn: N
            type: plainText
            heading {
                heading: Kota
            }
            layout {
                sequence: 60
            }
        )

        column PHONE (
            reportColumnQueryId: 7
            derivedColumn: N
            type: plainText
            heading {
                heading: Telepon
            }
            layout {
                sequence: 70
            }
        )

        column PAYMENT_TERM_DAYS (
            reportColumnQueryId: 8
            derivedColumn: N
            type: plainText
            heading {
                heading: TOP (hari)
                alignment: end
            }
            layout {
                sequence: 80
                columnAlignment: end
            }
        )

        column ACTIVE_YN (
            reportColumnQueryId: 9
            derivedColumn: N
            type: plainText
            heading {
                heading: Aktif
            }
            layout {
                sequence: 90
            }
        )

        column UPDATED_BY (
            reportColumnQueryId: 10
            derivedColumn: N
            type: plainText
            heading {
                heading: Diubah Oleh
            }
            layout {
                sequence: 100
            }
        )

        column UPDATED_ON (
            reportColumnQueryId: 11
            derivedColumn: N
            type: plainText
            heading {
                heading: Diubah
            }
            layout {
                sequence: 110
            }
        )

    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 10
            region: @button-bar
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 221
                clearCache: 221
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @master-data
        }
    )

    dynamicAction on-dialog-closed-refresh-report (
        name: ON_DIALOG_CLOSED_REFRESH_REPORT
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @results
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @results
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)
