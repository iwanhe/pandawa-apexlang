page 400 (
    name: Job Costing
    alias: JOB-COSTING
    title: Job Costing
    pageGroup: @reports
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @app-users
    }
    help {
        helpText: Actual costing per job (D-07): HPP aktual = material issue (biaya rata-rata) + biaya lain. Varians positif = penghematan.
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region job-costing (
        name: Job Costing
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select job_no, customer_name, status, qty_order, qty_produced, waste_pct, insheet_pct, selling_price, est_hpp, act_material, act_hpp, hpp_variance, act_margin_pct
                  from apx_mbms_job_cost_v
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: Tidak ada data.
        }
        actionsMenu {
            subscription: false
        }

        column JOB_NO (
            type: plainText
            heading {
                heading: No. Job
            }
            layout {
                sequence: 1
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        column CUSTOMER_NAME (
            type: plainText
            heading {
                heading: Customer
            }
            layout {
                sequence: 2
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column STATUS (
            type: plainText
            heading {
                heading: Status
            }
            layout {
                sequence: 3
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column QTY_ORDER (
            type: plainText
            heading {
                heading: Qty Order
                alignment: end
            }
            layout {
                sequence: 4
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G990D99
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: D
            }
        )

        column QTY_PRODUCED (
            type: plainText
            heading {
                heading: Produced
                alignment: end
            }
            layout {
                sequence: 5
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G990D99
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: E
            }
        )

        column WASTE_PCT (
            type: plainText
            heading {
                heading: Waste %
                alignment: end
            }
            layout {
                sequence: 6
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: F
            }
        )

        column INSHEET_PCT (
            type: plainText
            heading {
                heading: Toleransi %
                alignment: end
            }
            layout {
                sequence: 7
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: G
            }
        )

        column SELLING_PRICE (
            type: plainText
            heading {
                heading: Harga Jual
                alignment: end
            }
            layout {
                sequence: 8
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: H
            }
        )

        column EST_HPP (
            type: plainText
            heading {
                heading: Est. HPP
                alignment: end
            }
            layout {
                sequence: 9
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: I
            }
        )

        column ACT_MATERIAL (
            type: plainText
            heading {
                heading: Material Aktual
                alignment: end
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: J
            }
        )

        column ACT_HPP (
            type: plainText
            heading {
                heading: HPP Aktual
                alignment: end
            }
            layout {
                sequence: 11
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: K
            }
        )

        column HPP_VARIANCE (
            type: plainText
            heading {
                heading: Varians
                alignment: end
            }
            layout {
                sequence: 12
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: L
            }
        )

        column ACT_MARGIN_PCT (
            type: plainText
            heading {
                heading: Margin %
                alignment: end
            }
            layout {
                sequence: 13
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: M
            }
        )

        savedReport 400001 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn JOB_NO (
                sequence: 1
            )

            displayColumn CUSTOMER_NAME (
                sequence: 2
            )

            displayColumn STATUS (
                sequence: 3
            )

            displayColumn QTY_ORDER (
                sequence: 4
            )

            displayColumn QTY_PRODUCED (
                sequence: 5
            )

            displayColumn WASTE_PCT (
                sequence: 6
            )

            displayColumn INSHEET_PCT (
                sequence: 7
            )

            displayColumn SELLING_PRICE (
                sequence: 8
            )

            displayColumn EST_HPP (
                sequence: 9
            )

            displayColumn ACT_MATERIAL (
                sequence: 10
            )

            displayColumn ACT_HPP (
                sequence: 11
            )

            displayColumn HPP_VARIANCE (
                sequence: 12
            )

            displayColumn ACT_MARGIN_PCT (
                sequence: 13
            )

            sort (
                column: JOB_NO
                sort {
                    sequence: 1
                }
            )

        )

    )

)
