page 230 (
    name: Items
    alias: ITEMS
    title: Items
    pageGroup: @master-data
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @app-users
    }
    comments {
        comments:
            ```
            ## Purpose
            
            Daftar Items (master data).
            
            ## When to Use
            
            Mencari, memfilter, dan membuka Items. Create/Edit membuka form drawer di halaman 231 (item).
            
            ## AI Guidance
            
            Pola list: Interactive Report dari view apx_mbms_items_v (MVC: region membaca view, bukan tabel). Kolom ref tampil sebagai <KOLOM>_DSP. Hak akses list app-users, create/edit master-data.
            
            ## Source
            
            Generated dari app.yaml entities.ITEMS. Ubah app.yaml lalu jalankan scripts/generate.sh; jangan edit file ini.
            ```
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region items (
        name: Items
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select item_id, item_code, item_name, item_category, uom, bu_id_dsp, min_stock, std_cost, active_yn, updated_by, updated_on
                  from apx_mbms_items_v
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        comments {
            comments:
                ```
                Intent: Menampilkan Items yang bisa dicari dan difilter.
                Pattern role: Browse list (Interactive Report).
                AI guidance: Tambah kolom lewat columns di app.yaml (list: true/false), bukan dengan mengubah query ini.
                ```
        }
        link {
            linkColumn: customTarget
            target: {
                page: 231
                items: {
                    P231_ITEM_ID: \#ITEM_ID#\
                }
                clearCache: 231
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: Tidak ada data.
        }
        actionsMenu {
            subscription: false
        }

        column ITEM_ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 1
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        column ITEM_CODE (
            type: plainText
            heading {
                heading: Kode Item
            }
            layout {
                sequence: 2
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column ITEM_NAME (
            type: plainText
            heading {
                heading: Nama Item
            }
            layout {
                sequence: 3
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column ITEM_CATEGORY (
            type: plainText
            heading {
                heading: Kategori
            }
            layout {
                sequence: 4
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        column UOM (
            type: plainText
            heading {
                heading: UoM
            }
            layout {
                sequence: 5
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        column BU_ID_DSP (
            type: plainText
            heading {
                heading: Business Unit
            }
            layout {
                sequence: 6
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: F
            }
        )

        column MIN_STOCK (
            type: plainText
            heading {
                heading: Min. Stok
                alignment: end
            }
            layout {
                sequence: 7
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G990D99
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: G
            }
        )

        column STD_COST (
            type: plainText
            heading {
                heading: Std Cost
                alignment: end
            }
            layout {
                sequence: 8
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: H
            }
        )

        column ACTIVE_YN (
            type: plainText
            heading {
                heading: Aktif
            }
            layout {
                sequence: 9
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: I
            }
        )

        column UPDATED_BY (
            type: plainText
            heading {
                heading: Diubah Oleh
            }
            layout {
                sequence: 10
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: J
            }
        )

        column UPDATED_ON (
            type: plainText
            heading {
                heading: Diubah
            }
            layout {
                sequence: 11
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: K
            }
        )

        savedReport 230001 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn ITEM_CODE (
                sequence: 1
            )

            displayColumn ITEM_NAME (
                sequence: 2
            )

            displayColumn ITEM_CATEGORY (
                sequence: 3
            )

            displayColumn UOM (
                sequence: 4
            )

            displayColumn BU_ID_DSP (
                sequence: 5
            )

            displayColumn MIN_STOCK (
                sequence: 6
            )

            displayColumn STD_COST (
                sequence: 7
            )

            displayColumn ACTIVE_YN (
                sequence: 8
            )

            displayColumn UPDATED_BY (
                sequence: 9
            )

            displayColumn UPDATED_ON (
                sequence: 10
            )

            sort (
                column: ITEM_CODE
                sort {
                    sequence: 1
                }
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 10
            region: @items
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 231
                clearCache: 231
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @master-data
        }
    )

    dynamicAction on-dialog-closed-refresh-report (
        name: ON_DIALOG_CLOSED_REFRESH_REPORT
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @items
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @items
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)
