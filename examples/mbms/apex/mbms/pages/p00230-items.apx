page 230 (
    name: Items
    alias: ITEMS
    title: Items
    pageGroup: @master-data
    appearance {
        pageTemplate: @/left-side-column
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @app-users
    }
    comments {
        comments:
            ```
            ## Purpose
            
            Daftar Items (master data).
            
            ## When to Use
            
            Mencari, memfilter, dan membuka Items. Create/Edit membuka form drawer di halaman 231 (item).
            
            ## AI Guidance
            
            Pola faceted search (faceted-cards): facet di kolom kiri, hasil di body, dari view apx_mbms_items_v (MVC). Hak akses list app-users, create/edit master-data.
            
            ## Source
            
            Generated dari app.yaml entities.ITEMS. (list_type: faceted-cards) Ubah app.yaml lalu jalankan scripts/generate.sh; jangan edit file ini.
            ```
    }

    region button-bar (
        name: Items
        type: staticContent
        source {
            htmlCode: <span class="u-text-body-sm u-text-muted-color"><span id="total_row_count">-</span> baris</span>
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/hero
            templateOptions: [
                #DEFAULT#
                t-HeroRegion--hideIcon
            ]
        }
        comments {
            comments:
                ```
                Intent: Judul halaman, jumlah hasil, dan tombol Create.
                Pattern role: Page header with primary action.
                ```
        }
    )

    region search (
        name: Filter
        type: facetedSearch
        source {
            filteredRegion: @results
        }
        layout {
            sequence: 10
            slot: leftColumn
        }
        appearance {
            template: @/blank-with-attributes-no-grid
            templateOptions: #DEFAULT#
        }
        comments {
            comments:
                ```
                Intent: Mempersempit Items berdasarkan dimensi yang bermakna.
                Pattern role: Facets (Faceted Search).
                AI guidance: Facet otomatis dari kolom enum, yn, ref, dan status; atur dengan facet: true/false per kolom di app.yaml.
                ```
        }
        settings {
            showTotalRowCount: selector
            totalRowCountSelector: #total_row_count
        }

        facet P230_SEARCH (
            type: search
            label {
                label: Cari
            }
            layout {
                sequence: 10
            }
        )

        facet P230_ITEM_CATEGORY (
            type: checkboxGroup
            label {
                label: Kategori
            }
            lov {
                type: sharedComponent
                lov: @items-item-category
            }
            layout {
                sequence: 20
            }
            listEntries {
                maxDisplayedEntries: 7
                allowToExclude: false
            }
            source {
                databaseColumn: ITEM_CATEGORY
            }
        )

        facet P230_BU_ID_DSP (
            type: checkboxGroup
            label {
                label: Business Unit
            }
            lov {
                type: distinctValues
            }
            layout {
                sequence: 30
            }
            listEntries {
                maxDisplayedEntries: 7
                allowToExclude: false
            }
            source {
                databaseColumn: BU_ID_DSP
            }
        )

        facet P230_ACTIVE_YN (
            type: checkboxGroup
            label {
                label: Aktif
            }
            lov {
                type: sharedComponent
                lov: @yes-no
            }
            layout {
                sequence: 40
            }
            listEntries {
                maxDisplayedEntries: 7
                allowToExclude: false
            }
            source {
                databaseColumn: ACTIVE_YN
            }
        )

    )

    region results (
        name: Hasil Items
        type: cards
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select item_id
                      ,item_code
                      ,item_name
                      ,item_category
                      ,uom
                      ,bu_id_dsp
                      ,min_stock
                      ,std_cost
                      ,active_yn
                      ,updated_by
                      ,updated_on
                  from apx_mbms_items_v
                ```
        }
        orderBy {
            type: staticValue
            orderByClause: ITEM_CODE
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/cards-container
            templateOptions: [
                #DEFAULT#
                t-CardsRegion--hideHeader js-addHiddenHeadingRoleDesc
                t-CardsRegion--styleC
            ]
        }
        comments {
            comments:
                ```
                Intent: Hasil pencarian Items yang sudah difilter facet.
                Pattern role: Faceted search results (Cards).
                AI guidance: Klik judul kartu untuk membuka form. Kolom kartu diambil dari columns di app.yaml.
                ```
        }
        messages {
            whenNoDataFound: Tidak ada data.
        }
        title {
            column: ITEM_CODE
        }
        subtitle {
            column: ITEM_NAME
        }
        body {
            column: ITEM_CATEGORY
        }
        iconAndBadge {
            iconSource: iconClass
            iconCssClasses: fa fa-tag
        }

        action open (
            type: title
            layout {
                sequence: 10
            }
            behavior {
                type: redirectThisApp
                target: {
                    page: 231
                    items: {
                        P231_ITEM_ID: &ITEM_ID.
                    }
                    clearCache: 231
                }
            }
        )

    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 10
            region: @button-bar
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 231
                clearCache: 231
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @master-data
        }
    )

    dynamicAction on-dialog-closed-refresh-report (
        name: ON_DIALOG_CLOSED_REFRESH_REPORT
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @results
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @results
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)
