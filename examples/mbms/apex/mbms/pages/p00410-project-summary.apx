page 410 (
    name: Project Summary
    alias: PROJECT-SUMMARY
    title: Project Summary
    pageGroup: @reports
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @app-users
    }
    help {
        helpText: Estimasi rugi = budget melebihi nilai kontrak (PSAK 72 onerous contract).
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region project-summary (
        name: Project Summary
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select project_no, project_name, customer_name, status, progress_pct, contract_value, retention_amount, budget_amount, actual_amount, cost_variance, loss_warning_yn, overdue_yn
                  from apx_mbms_project_summary_v
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: Tidak ada data.
        }
        actionsMenu {
            subscription: false
        }

        column PROJECT_NO (
            type: plainText
            heading {
                heading: No. Proyek
            }
            layout {
                sequence: 1
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        column PROJECT_NAME (
            type: plainText
            heading {
                heading: Proyek
            }
            layout {
                sequence: 2
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column CUSTOMER_NAME (
            type: plainText
            heading {
                heading: Customer
            }
            layout {
                sequence: 3
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column STATUS (
            type: plainText
            heading {
                heading: Status
            }
            layout {
                sequence: 4
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        column PROGRESS_PCT (
            type: plainText
            heading {
                heading: Progres %
                alignment: end
            }
            layout {
                sequence: 5
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: E
            }
        )

        column CONTRACT_VALUE (
            type: plainText
            heading {
                heading: Nilai Kontrak
                alignment: end
            }
            layout {
                sequence: 6
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: F
            }
        )

        column RETENTION_AMOUNT (
            type: plainText
            heading {
                heading: Retensi
                alignment: end
            }
            layout {
                sequence: 7
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: G
            }
        )

        column BUDGET_AMOUNT (
            type: plainText
            heading {
                heading: Budget
                alignment: end
            }
            layout {
                sequence: 8
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: H
            }
        )

        column ACTUAL_AMOUNT (
            type: plainText
            heading {
                heading: Aktual
                alignment: end
            }
            layout {
                sequence: 9
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: I
            }
        )

        column COST_VARIANCE (
            type: plainText
            heading {
                heading: Cost Variance
                alignment: end
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: J
            }
        )

        column LOSS_WARNING_YN (
            type: plainText
            heading {
                heading: Estimasi Rugi?
            }
            layout {
                sequence: 11
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: K
            }
        )

        column OVERDUE_YN (
            type: plainText
            heading {
                heading: Terlambat?
            }
            layout {
                sequence: 12
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: L
            }
        )

        savedReport 410001 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn PROJECT_NO (
                sequence: 1
            )

            displayColumn PROJECT_NAME (
                sequence: 2
            )

            displayColumn CUSTOMER_NAME (
                sequence: 3
            )

            displayColumn STATUS (
                sequence: 4
            )

            displayColumn PROGRESS_PCT (
                sequence: 5
            )

            displayColumn CONTRACT_VALUE (
                sequence: 6
            )

            displayColumn RETENTION_AMOUNT (
                sequence: 7
            )

            displayColumn BUDGET_AMOUNT (
                sequence: 8
            )

            displayColumn ACTUAL_AMOUNT (
                sequence: 9
            )

            displayColumn COST_VARIANCE (
                sequence: 10
            )

            displayColumn LOSS_WARNING_YN (
                sequence: 11
            )

            displayColumn OVERDUE_YN (
                sequence: 12
            )

            sort (
                column: PROJECT_NO
                sort {
                    sequence: 1
                }
            )

        )

    )

)
