page 311 (
    name: Project
    alias: PROJECT
    title: Project
    pageGroup: @engineering
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        chained: false
        resizable: true
    }
    security {
        authorizationScheme: @engineering
    }
    comments {
        comments:
            ```
            ## Purpose
            
            Form Project.
            
            ## When to Use
            
            Dibuka dari halaman list 310 (projects) untuk create/edit satu record.
            
            ## AI Guidance
            
            Dokumen ber-approval PRJ: DRAFT -> Submit for Approval -> APPROVED/REJECTED. Kolom CUSTOMER_ID, CONTRACT_VALUE terkunci setelah approval. Logika ada di apx_mbms_approval_pkg dan trigger, bukan di halaman.
            
            ## Source
            
            Generated dari app.yaml entities.PROJECTS (form_style: modal). Ubah app.yaml lalu jalankan scripts/generate.sh; jangan edit file ini.
            ```
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region projects (
        name: Project
        type: form
        source {
            location: localDatabase
            tableName: APX_MBMS_PROJECTS
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        comments {
            comments:
                ```
                Intent: Membuat dan mengubah satu record Project.
                Pattern role: Single-record form (modal).
                AI guidance: Validasi bisnis ada di trigger apx_mbms_projects_trg dan package; item ini hanya UI. Status hanya berubah lewat approval engine.
                ```
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P311_PROJECT_ID (
        type: hidden
        layout {
            sequence: 5
            region: @projects
            slot: regionBody
        }
        source {
            formRegion: @projects
            column: PROJECT_ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P311_PROJECT_NO (
        type: displayOnly
        label {
            label: No. Project Budget
            alignment: right
        }
        settings {
            sendOnPageSubmit: false
        }
        layout {
            sequence: 10
            region: @projects
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @projects
            column: PROJECT_NO
            dataType: varchar2
            queryOnly: true
        }
    )

    pageItem P311_STATUS (
        type: selectList
        label {
            label: Status
            alignment: right
        }
        lov {
            type: sharedComponent
            lov: @projects-status
            displayExtraValues: true
            displayNullValue: true
            nullDisplayValue: - Pilih -
        }
        layout {
            sequence: 15
            region: @projects
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            formRegion: @projects
            column: STATUS
            dataType: varchar2
        }
        default {
            type: static
            staticValue: DRAFT
        }
        readOnly {
            type: expression
            plsqlExpression: nvl(:P311_STATUS,'DRAFT') not in ('APPROVED','IN_PROGRESS','COMPLETED','CLOSED')
        }
        help {
            inlineHelpText: Status operasional setelah approved. Approval lewat Submit for Approval.
        }
    )

    pageItem P311_BU_ID (
        type: hidden
        layout {
            sequence: 25
            region: @projects
            slot: regionBody
        }
        source {
            formRegion: @projects
            column: BU_ID
            dataType: number
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue: select bu_id from apx_mbms_business_units where bu_code = 'ENG'
        }
    )

    pageItem P311_PROJECT_NAME (
        type: textField
        label {
            label: Nama Proyek
            alignment: right
        }
        layout {
            sequence: 35
            region: @projects
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 60
        }
        validation {
            valueRequired: true
            maxLength: 300
        }
        source {
            formRegion: @projects
            column: PROJECT_NAME
            dataType: varchar2
        }
    )

    pageItem P311_PROJECT_TYPE (
        type: selectList
        label {
            label: Tipe
            alignment: right
        }
        lov {
            type: sharedComponent
            lov: @projects-project-type
            displayExtraValues: true
            displayNullValue: true
            nullDisplayValue: - Pilih -
        }
        layout {
            sequence: 45
            region: @projects
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @projects
            column: PROJECT_TYPE
            dataType: varchar2
        }
        default {
            type: static
            staticValue: FABRICATION
        }
    )

    pageItem P311_CUSTOMER_ID (
        type: selectList
        label {
            label: Customer
            alignment: right
        }
        lov {
            type: sharedComponent
            lov: @customers
            displayExtraValues: true
            displayNullValue: true
            nullDisplayValue: - Pilih -
        }
        layout {
            sequence: 55
            region: @projects
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @projects
            column: CUSTOMER_ID
            dataType: number
        }
        readOnly {
            type: expression
            plsqlExpression: not (nvl(:P311_STATUS,'DRAFT') in ('DRAFT','REJECTED'))
        }
    )

    pageItem P311_CONTRACT_VALUE (
        type: numberField
        label {
            label: Nilai Kontrak
            alignment: right
        }
        settings {
            numberAlignment: end
            virtualKeyboard: decimal
            minValue: 0
        }
        layout {
            sequence: 65
            region: @projects
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @projects
            column: CONTRACT_VALUE
            dataType: number
        }
        default {
            type: static
            staticValue: 0
        }
        readOnly {
            type: expression
            plsqlExpression: not (nvl(:P311_STATUS,'DRAFT') in ('DRAFT','REJECTED'))
        }
    )

    pageItem P311_RETENTION_PCT (
        type: numberField
        label {
            label: Retensi (%)
            alignment: right
        }
        settings {
            numberAlignment: end
            virtualKeyboard: decimal
            minValue: 0
            maxValue: 100
        }
        layout {
            sequence: 75
            region: @projects
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @projects
            column: RETENTION_PCT
            dataType: number
        }
        default {
            type: static
            staticValue: 5
        }
    )

    pageItem P311_START_DATE (
        type: datePicker
        label {
            label: Mulai
            alignment: right
        }
        layout {
            sequence: 85
            region: @projects
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        source {
            formRegion: @projects
            column: START_DATE
            dataType: date
        }
    )

    pageItem P311_END_DATE (
        type: datePicker
        label {
            label: Target Selesai
            alignment: right
        }
        layout {
            sequence: 95
            region: @projects
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        source {
            formRegion: @projects
            column: END_DATE
            dataType: date
        }
    )

    pageItem P311_PROGRESS_PCT (
        type: numberField
        label {
            label: Progres (%)
            alignment: right
        }
        settings {
            numberAlignment: end
            virtualKeyboard: decimal
            minValue: 0
            maxValue: 100
        }
        layout {
            sequence: 105
            region: @projects
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @projects
            column: PROGRESS_PCT
            dataType: number
        }
        default {
            type: static
            staticValue: 0
        }
    )

    pageItem P311_PROJECT_MANAGER (
        type: textField
        label {
            label: Project Manager
            alignment: right
        }
        layout {
            sequence: 115
            region: @projects
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 60
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @projects
            column: PROJECT_MANAGER
            dataType: varchar2
        }
    )

    pageItem P311_NOTES (
        type: textarea
        label {
            label: Catatan
            alignment: right
        }
        layout {
            sequence: 125
            region: @projects
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 60
            height: 3
        }
        validation {
            maxLength: 1000
        }
        source {
            formRegion: @projects
            column: NOTES
            dataType: varchar2
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--simple
            ]
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P311_PROJECT_ID is not null and nvl(:P311_STATUS,'DRAFT') = 'DRAFT'
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P311_PROJECT_ID is not null and nvl(:P311_STATUS,'DRAFT') not in ('SUBMITTED','CANCELLED','CLOSED')
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P311_PROJECT_ID is null
        }
    )

    button submit (
        buttonName: SUBMIT
        label: Submit for Approval
        layout {
            sequence: 50
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
            requiresConfirmation: true
        }
        confirmation {
            message: Ajukan dokumen ini untuk approval? Setelah diajukan dokumen terkunci.
            style: information
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P311_PROJECT_ID is not null and nvl(:P311_STATUS,'DRAFT') in ('DRAFT','REJECTED')
        }
    )

    dynamicAction on-click-cancel-close-dialog (
        name: ON_CLICK_CANCEL_CLOSE_DIALOG
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process init-projects-form (
        name: INIT_PROJECTS_FORM
        type: formInitialization
        formRegion: @projects
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 900311001
        }
    )

    process save-projects (
        name: SAVE_PROJECTS
        type: formAutoRowProcessing
        formRegion: @projects
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 900311002
        }
    )

    process call-submit-projects (
        name: CALL_SUBMIT_PROJECTS
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                apx_mbms_approval_pkg.submit(p_doc_type => 'PRJ', p_doc_id => :P311_PROJECT_ID);
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Dokumen diajukan untuk approval.
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
        advanced {
            executionMappingIdentifier: 900311003
        }
    )

    process close-dialog (
        name: CLOSE_DIALOG
        type: closeDialog
        settings {
            showSuccessMessages: true
        }
        execution {
            sequence: 50
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: DELETE,SAVE,CREATE,SUBMIT
        }
        advanced {
            executionMappingIdentifier: 900311004
        }
    )

)
