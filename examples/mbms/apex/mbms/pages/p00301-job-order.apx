    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--simple
            ]
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P301_JOB_ID is not null and nvl(:P301_STATUS,'DRAFT') = 'DRAFT'
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P301_JOB_ID is not null and nvl(:P301_STATUS,'DRAFT') not in ('SUBMITTED','CANCELLED','CLOSED')
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P301_JOB_ID is null
        }
    )

    button submit (
        buttonName: SUBMIT
        label: Submit for Approval
        layout {
            sequence: 50
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
            requiresConfirmation: true
        }
        confirmation {
            message: Ajukan dokumen ini untuk approval? Setelah diajukan dokumen terkunci.
            style: information
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P301_JOB_ID is not null and nvl(:P301_STATUS,'DRAFT') in ('DRAFT','REJECTED')
        }
    )

    dynamicAction on-click-cancel-close-dialog (
        name: ON_CLICK_CANCEL_CLOSE_DIALOG
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation check-job-orders-1 (
        name: CUSTOMER_REQUIRED_FOR_MTO
        execution {
            sequence: 10
        }
        validation {
            type: expression
            plsqlExpression: :P301_JOB_TYPE = 'STOCK' or :P301_CUSTOMER_ID is not null
        }
        error {
            errorMessage: Customer wajib diisi untuk job Make to Order.
            displayLocation: inlineWithFieldAndInNotification
            associatedItem: @P301_CUSTOMER_ID
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: SAVE,CREATE,SUBMIT
        }
    )

    process init-job-orders-form (
        name: INIT_JOB_ORDERS_FORM
        type: formInitialization
        formRegion: @job-orders
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 900301001
        }
    )

    process save-job-orders (
        name: SAVE_JOB_ORDERS
        type: formAutoRowProcessing
        formRegion: @job-orders
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 900301002
        }
    )

    process call-submit-job-orders (
        name: CALL_SUBMIT_JOB_ORDERS
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                apx_mbms_approval_pkg.submit(p_doc_type => 'JO', p_doc_id => :P301_JOB_ID);
                ```
        }
        execution {
            sequence: 20
