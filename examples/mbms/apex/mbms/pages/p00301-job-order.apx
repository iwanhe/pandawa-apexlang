page 301 (
    name: Job Order
    alias: JOB-ORDER
    title: Job Order
    pageGroup: @printing
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        chained: false
        resizable: true
    }
    security {
        authorizationScheme: @printing
    }
    comments {
        comments:
            ```
            ## Purpose
            
            Form Job Order.
            
            ## When to Use
            
            Dibuka dari halaman list 300 (job-orders) untuk create/edit satu record.
            
            ## AI Guidance
            
            Dokumen ber-approval JO: DRAFT -> Submit for Approval -> APPROVED/REJECTED. Kolom JOB_TYPE, CUSTOMER_ID, PRODUCT_DESC, QTY_ORDER, UPS_PER_SHEET, INSHEET_PCT, SELLING_PRICE, EST_PAPER, EST_INK, EST_PLATE, EST_MACHINE, EST_FINISHING, EST_LABOR, EST_OVERHEAD terkunci setelah approval. Logika ada di apx_mbms_approval_pkg dan trigger, bukan di halaman.
            
            ## Source
            
            Generated dari app.yaml entities.JOB_ORDERS (form_style: modal). Ubah app.yaml lalu jalankan scripts/generate.sh; jangan edit file ini.
            ```
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region job-orders (
        name: Job Order
        type: form
        source {
            location: localDatabase
            tableName: APX_MBMS_JOB_ORDERS
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        comments {
            comments:
                ```
                Intent: Membuat dan mengubah satu record Job Order.
                Pattern role: Single-record form (modal).
                AI guidance: Validasi bisnis ada di trigger apx_mbms_job_orders_trg dan package; item ini hanya UI. Status hanya berubah lewat approval engine.
                ```
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P301_JOB_ID (
        type: hidden
        layout {
            sequence: 5
            region: @job-orders
            slot: regionBody
        }
        source {
            formRegion: @job-orders
            column: JOB_ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P301_JOB_NO (
        type: displayOnly
        label {
            label: No. Job Order
            alignment: right
        }
        settings {
            sendOnPageSubmit: false
        }
        layout {
            sequence: 10
            region: @job-orders
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @job-orders
            column: JOB_NO
            dataType: varchar2
            queryOnly: true
        }
    )

    pageItem P301_STATUS (
        type: selectList
        label {
            label: Status
            alignment: right
        }
        lov {
            type: sharedComponent
            lov: @job-orders-status
            displayExtraValues: true
            displayNullValue: true
            nullDisplayValue: - Pilih -
        }
        layout {
            sequence: 15
            region: @job-orders
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            formRegion: @job-orders
            column: STATUS
            dataType: varchar2
        }
        default {
            type: static
            staticValue: DRAFT
        }
        readOnly {
            type: expression
            plsqlExpression: nvl(:P301_STATUS,'DRAFT') not in ('APPROVED','IN_PROGRESS','COMPLETED','CLOSED')
        }
        help {
            inlineHelpText: Status operasional setelah approved. Approval lewat Submit for Approval.
        }
    )

    pageItem P301_BU_ID (
        type: hidden
        layout {
            sequence: 25
            region: @job-orders
            slot: regionBody
        }
        source {
            formRegion: @job-orders
            column: BU_ID
            dataType: number
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue: select bu_id from apx_mbms_business_units where bu_code = 'PRT'
        }
    )

