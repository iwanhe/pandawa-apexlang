page 350 (
    name: Stock Transactions
    alias: STOCK-TRANSACTIONS
    title: Stock Transactions
    pageGroup: @inventory
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @app-users
    }
    help {
        helpText: Stock ledger. Transaksi yang sudah diposting tidak dapat diubah/dihapus; koreksi dengan ADJ_IN/ADJ_OUT/RETURN.
    }
    comments {
        comments:
            ```
            ## Purpose
            
            Daftar Stock Transactions (master data).
            
            ## When to Use
            
            Mencari, memfilter, dan membuka Stock Transactions. Create/Edit membuka form drawer di halaman 351 (stock-transaction).
            
            ## AI Guidance
            
            Pola list: Interactive Report dari view apx_mbms_stock_txns_v (MVC: region membaca view, bukan tabel). Kolom ref tampil sebagai <KOLOM>_DSP. Hak akses list app-users, create/edit warehouse.
            
            ## Source
            
            Generated dari app.yaml entities.STOCK_TXNS. Ubah app.yaml lalu jalankan scripts/generate.sh; jangan edit file ini.
            ```
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region stock-txns (
        name: Stock Transactions
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select txn_id, txn_no, txn_date, txn_type, bu_id_dsp, warehouse_id_dsp, item_id_dsp, qty, qty_signed, unit_cost, total_cost, job_id_dsp, project_id_dsp, wbs_id_dsp, reference, updated_by, updated_on
                  from apx_mbms_stock_txns_v
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        comments {
            comments:
                ```
                Intent: Menampilkan Stock Transactions yang bisa dicari dan difilter.
                Pattern role: Browse list (Interactive Report).
                AI guidance: Tambah kolom lewat columns di app.yaml (list: true/false), bukan dengan mengubah query ini.
                ```
        }
        link {
            linkColumn: customTarget
            target: {
                page: 351
                items: {
                    P351_TXN_ID: \#TXN_ID#\
                }
                clearCache: 351
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: Tidak ada data.
        }
        actionsMenu {
            subscription: false
        }

        column TXN_ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 1
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        column TXN_NO (
            type: plainText
            heading {
                heading: No. Transaksi
            }
            layout {
                sequence: 2
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column TXN_DATE (
            type: plainText
            heading {
                heading: Tanggal
            }
            layout {
                sequence: 3
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: C
            }
        )

        column TXN_TYPE (
            type: plainText
            heading {
                heading: Tipe
            }
            layout {
                sequence: 4
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        column BU_ID_DSP (
            type: plainText
            heading {
                heading: BU
            }
            layout {
                sequence: 5
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        column WAREHOUSE_ID_DSP (
            type: plainText
            heading {
                heading: Gudang / Lokasi
            }
            layout {
                sequence: 6
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: F
            }
        )

        column ITEM_ID_DSP (
            type: plainText
            heading {
                heading: Item
            }
            layout {
                sequence: 7
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: G
            }
        )

        column QTY (
            type: plainText
            heading {
                heading: Qty
                alignment: end
            }
            layout {
                sequence: 8
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G990D99
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: H
            }
        )

        column QTY_SIGNED (
            type: plainText
            heading {
                heading: Qty (+/-)
                alignment: end
            }
            layout {
                sequence: 9
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G990D99
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: I
            }
        )

        column UNIT_COST (
            type: plainText
            heading {
                heading: Biaya Satuan
                alignment: end
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: J
            }
        )

        column TOTAL_COST (
            type: plainText
            heading {
                heading: Total Biaya
                alignment: end
            }
            layout {
                sequence: 11
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: K
            }
        )

        column JOB_ID_DSP (
            type: plainText
            heading {
                heading: Job Order
            }
            layout {
                sequence: 12
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: L
            }
        )

        column PROJECT_ID_DSP (
            type: plainText
            heading {
                heading: Proyek
            }
            layout {
                sequence: 13
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: M
            }
        )

        column WBS_ID_DSP (
            type: plainText
            heading {
                heading: WBS
            }
            layout {
                sequence: 14
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: N
            }
        )

        column REFERENCE (
            type: plainText
            heading {
                heading: Referensi
            }
            layout {
                sequence: 15
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: O
            }
        )

        column UPDATED_BY (
            type: plainText
            heading {
                heading: Diubah Oleh
            }
            layout {
                sequence: 16
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: P
            }
        )

        column UPDATED_ON (
            type: plainText
            heading {
                heading: Diubah
            }
            layout {
                sequence: 17
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: Q
            }
        )

        savedReport 350001 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn TXN_NO (
                sequence: 1
            )

            displayColumn TXN_DATE (
                sequence: 2
            )

            displayColumn TXN_TYPE (
                sequence: 3
            )

            displayColumn BU_ID_DSP (
                sequence: 4
            )

            displayColumn WAREHOUSE_ID_DSP (
                sequence: 5
            )

            displayColumn ITEM_ID_DSP (
                sequence: 6
            )

            displayColumn QTY (
                sequence: 7
            )

            displayColumn QTY_SIGNED (
                sequence: 8
            )

            displayColumn UNIT_COST (
                sequence: 9
            )

            displayColumn TOTAL_COST (
                sequence: 10
            )

            displayColumn JOB_ID_DSP (
                sequence: 11
            )

            displayColumn PROJECT_ID_DSP (
                sequence: 12
            )

            displayColumn WBS_ID_DSP (
                sequence: 13
            )

            displayColumn REFERENCE (
                sequence: 14
            )

            displayColumn UPDATED_BY (
                sequence: 15
            )

            displayColumn UPDATED_ON (
                sequence: 16
            )

            sort (
                column: TXN_NO
                sort {
                    sequence: 1
                }
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 10
            region: @stock-txns
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 351
                clearCache: 351
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @warehouse
        }
    )

    dynamicAction on-dialog-closed-refresh-report (
        name: ON_DIALOG_CLOSED_REFRESH_REPORT
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @stock-txns
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @stock-txns
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)
