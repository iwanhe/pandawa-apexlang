page 350 (
    name: Stock Transactions
    alias: STOCK-TRANSACTIONS
    title: Stock Transactions
    pageGroup: @inventory
    appearance {
        pageTemplate: @/left-side-column
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @app-users
    }
    help {
        helpText: Stock ledger. Transaksi yang sudah diposting tidak dapat diubah/dihapus; koreksi dengan ADJ_IN/ADJ_OUT/RETURN.
    }
    comments {
        comments:
            ```
            ## Purpose
            
            Daftar Stock Transactions (master data).
            
            ## When to Use
            
            Mencari, memfilter, dan membuka Stock Transactions. Create/Edit membuka form modal di halaman 351 (stock-transaction).
            
            ## AI Guidance
            
            Pola faceted search (faceted-report): facet di kolom kiri, hasil di body, dari view apx_mbms_stock_txns_v (MVC). Hak akses list app-users, create/edit warehouse.
            
            ## Source
            
            Generated dari app.yaml entities.STOCK_TXNS. (list_type: faceted-report) Ubah app.yaml lalu jalankan scripts/generate.sh; jangan edit file ini.
            ```
    }

    region button-bar (
        name: Stock Transactions
        type: staticContent
        source {
            htmlCode: <span class="u-text-body-sm u-text-muted-color"><span id="total_row_count">-</span> baris</span>
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/hero
            templateOptions: [
                #DEFAULT#
                t-HeroRegion--hideIcon
            ]
        }
        comments {
            comments:
                ```
                Intent: Judul halaman, jumlah hasil, dan tombol Create.
                Pattern role: Page header with primary action.
                ```
        }
    )

    region search (
        name: Filter
        type: facetedSearch
        source {
            filteredRegion: @results
        }
        layout {
            sequence: 10
            slot: leftColumn
        }
        appearance {
            template: @/blank-with-attributes-no-grid
            templateOptions: #DEFAULT#
        }
        comments {
            comments:
                ```
                Intent: Mempersempit Stock Transactions berdasarkan dimensi yang bermakna.
                Pattern role: Facets (Faceted Search).
                AI guidance: Facet otomatis dari kolom enum, yn, ref, dan status; atur dengan facet: true/false per kolom di app.yaml.
                ```
        }
        settings {
            showTotalRowCount: selector
            totalRowCountSelector: #total_row_count
        }

        facet P350_SEARCH (
            type: search
            label {
                label: Cari
            }
            layout {
                sequence: 10
            }
        )

        facet P350_TXN_TYPE (
            type: checkboxGroup
            label {
                label: Tipe
            }
            lov {
                type: sharedComponent
                lov: @stock-txns-txn-type
            }
            layout {
                sequence: 20
            }
            listEntries {
                maxDisplayedEntries: 7
                allowToExclude: false
            }
            source {
                databaseColumn: TXN_TYPE
            }
        )

        facet P350_BU_ID_DSP (
            type: checkboxGroup
            label {
                label: BU
            }
            lov {
                type: distinctValues
            }
            layout {
                sequence: 30
            }
            listEntries {
                maxDisplayedEntries: 7
                allowToExclude: false
            }
            source {
                databaseColumn: BU_ID_DSP
            }
        )

        facet P350_WAREHOUSE_ID_DSP (
            type: checkboxGroup
            label {
                label: Gudang / Lokasi
            }
            lov {
                type: distinctValues
            }
            layout {
                sequence: 40
            }
            listEntries {
                maxDisplayedEntries: 7
                allowToExclude: false
            }
            source {
                databaseColumn: WAREHOUSE_ID_DSP
            }
        )

        facet P350_ITEM_ID_DSP (
            type: checkboxGroup
            label {
                label: Item
            }
            lov {
                type: distinctValues
            }
            layout {
                sequence: 50
            }
            listEntries {
                maxDisplayedEntries: 7
                allowToExclude: false
            }
            source {
                databaseColumn: ITEM_ID_DSP
            }
        )

        facet P350_JOB_ID_DSP (
            type: checkboxGroup
            label {
                label: Job Order
            }
            lov {
                type: distinctValues
            }
            layout {
                sequence: 60
            }
            listEntries {
                maxDisplayedEntries: 7
                allowToExclude: false
            }
            source {
                databaseColumn: JOB_ID_DSP
            }
        )

        facet P350_PROJECT_ID_DSP (
            type: checkboxGroup
            label {
                label: Proyek
            }
            lov {
                type: distinctValues
            }
            layout {
                sequence: 70
            }
            listEntries {
                maxDisplayedEntries: 7
                allowToExclude: false
            }
            source {
                databaseColumn: PROJECT_ID_DSP
            }
        )

        facet P350_WBS_ID_DSP (
            type: checkboxGroup
            label {
                label: WBS
            }
            lov {
                type: distinctValues
            }
            layout {
                sequence: 80
            }
            listEntries {
                maxDisplayedEntries: 7
                allowToExclude: false
            }
            source {
                databaseColumn: WBS_ID_DSP
            }
        )

    )

    region results (
        name: Hasil Stock Transactions
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select txn_id
                      ,txn_no
                      ,txn_date
                      ,txn_type
                      ,bu_id_dsp
                      ,warehouse_id_dsp
                      ,item_id_dsp
                      ,qty
                      ,qty_signed
                      ,unit_cost
                      ,total_cost
                      ,job_id_dsp
                      ,project_id_dsp
                      ,wbs_id_dsp
                      ,reference
                      ,updated_by
                      ,updated_on
                  from apx_mbms_stock_txns_v
                ```
        }
        orderBy {
            type: staticValue
            orderByClause: TXN_NO
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noUI
            ]
        }
        comments {
            comments:
                ```
                Intent: Hasil pencarian Stock Transactions yang sudah difilter facet.
                Pattern role: Faceted search results (Classic Report).
                AI guidance: Klik kolom judul untuk membuka form. Kolom diambil dari columns di app.yaml.
                ```
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        messages {
            whenNoDataFound: Tidak ada data.
        }

        column TXN_ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 10
            }
        )

        column TXN_NO (
            reportColumnQueryId: 2
            derivedColumn: N
            type: link
            heading {
                heading: No. Transaksi
            }
            layout {
                sequence: 20
            }
            link {
                target: {
                    page: 351
                    items: {
                        P351_TXN_ID: #TXN_ID#
                    }
                    clearCache: 351
                }
                linkText: #TXN_NO#
                linkAttributes: class="u-text-bold"
            }
        )

        column TXN_DATE (
            reportColumnQueryId: 3
            derivedColumn: N
            type: plainText
            heading {
                heading: Tanggal
            }
            layout {
                sequence: 30
            }
        )

        column TXN_TYPE (
            reportColumnQueryId: 4
            derivedColumn: N
            type: plainText
            heading {
                heading: Tipe
            }
            layout {
                sequence: 40
            }
        )

        column BU_ID_DSP (
            reportColumnQueryId: 5
            derivedColumn: N
            type: plainText
            heading {
                heading: BU
            }
            layout {
                sequence: 50
            }
        )

        column WAREHOUSE_ID_DSP (
            reportColumnQueryId: 6
            derivedColumn: N
            type: plainText
            heading {
                heading: Gudang / Lokasi
            }
            layout {
                sequence: 60
            }
        )

        column ITEM_ID_DSP (
            reportColumnQueryId: 7
            derivedColumn: N
            type: plainText
            heading {
                heading: Item
            }
            layout {
                sequence: 70
            }
        )

        column QTY (
            reportColumnQueryId: 8
            derivedColumn: N
            type: plainText
            heading {
                heading: Qty
                alignment: end
            }
            layout {
                sequence: 80
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G990D99
            }
        )

        column QTY_SIGNED (
            reportColumnQueryId: 9
            derivedColumn: N
            type: plainText
            heading {
                heading: Qty (+/-)
                alignment: end
            }
            layout {
                sequence: 90
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G990D99
            }
        )

        column UNIT_COST (
            reportColumnQueryId: 10
            derivedColumn: N
            type: plainText
            heading {
                heading: Biaya Satuan
                alignment: end
            }
            layout {
                sequence: 100
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990
            }
        )

        column TOTAL_COST (
            reportColumnQueryId: 11
            derivedColumn: N
            type: plainText
            heading {
                heading: Total Biaya
                alignment: end
            }
            layout {
                sequence: 110
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990
            }
        )

        column JOB_ID_DSP (
            reportColumnQueryId: 12
            derivedColumn: N
            type: plainText
            heading {
                heading: Job Order
            }
            layout {
                sequence: 120
            }
        )

        column PROJECT_ID_DSP (
            reportColumnQueryId: 13
            derivedColumn: N
            type: plainText
            heading {
                heading: Proyek
            }
            layout {
                sequence: 130
            }
        )

        column WBS_ID_DSP (
            reportColumnQueryId: 14
            derivedColumn: N
            type: plainText
            heading {
                heading: WBS
            }
            layout {
                sequence: 140
            }
        )

        column REFERENCE (
            reportColumnQueryId: 15
            derivedColumn: N
            type: plainText
            heading {
                heading: Referensi
            }
            layout {
                sequence: 150
            }
        )

        column UPDATED_BY (
            reportColumnQueryId: 16
            derivedColumn: N
            type: plainText
            heading {
                heading: Diubah Oleh
            }
            layout {
                sequence: 160
            }
        )

        column UPDATED_ON (
            reportColumnQueryId: 17
            derivedColumn: N
            type: plainText
            heading {
                heading: Diubah
            }
            layout {
                sequence: 170
            }
        )

    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 10
            region: @button-bar
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 351
                clearCache: 351
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @warehouse
        }
    )

    dynamicAction on-dialog-closed-refresh-report (
        name: ON_DIALOG_CLOSED_REFRESH_REPORT
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @results
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @results
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)
