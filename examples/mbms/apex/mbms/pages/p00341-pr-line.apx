page 341 (
    name: PR Line
    alias: PR-LINE
    title: PR Line
    pageGroup: @procurement
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
    }
    security {
        authorizationScheme: @app-users
    }
    comments {
        comments:
            ```
            ## Purpose
            
            Form PR Line.
            
            ## When to Use
            
            Dibuka dari halaman list 340 (pr-lines) untuk create/edit satu record.
            
            ## AI Guidance
            
            Form pendek; simpan dengan Create/Apply Changes. Logika validasi di database (trigger/constraint).
            
            ## Source
            
            Generated dari app.yaml entities.PR_LINES (form_style: drawer). Ubah app.yaml lalu jalankan scripts/generate.sh; jangan edit file ini.
            ```
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region pr-lines (
        name: PR Line
        type: form
        source {
            location: localDatabase
            tableName: APX_MBMS_PR_LINES
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        comments {
            comments:
                ```
                Intent: Membuat dan mengubah satu record PR Line.
                Pattern role: Single-record form (drawer).
                AI guidance: Validasi bisnis ada di trigger apx_mbms_pr_lines_trg dan package; item ini hanya UI.
                ```
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P341_LINE_ID (
        type: hidden
        layout {
            sequence: 5
            region: @pr-lines
            slot: regionBody
        }
        source {
            formRegion: @pr-lines
            column: LINE_ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P341_PR_ID (
        type: selectList
        label {
            label: No. PR
            alignment: right
        }
        lov {
            type: sharedComponent
            lov: @purchase-reqs
            displayExtraValues: true
            displayNullValue: true
            nullDisplayValue: - Pilih -
        }
        layout {
            sequence: 15
            region: @pr-lines
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @pr-lines
            column: PR_ID
            dataType: number
        }
    )

    pageItem P341_ITEM_ID (
        type: selectList
        label {
            label: Item
            alignment: right
        }
        lov {
            type: sharedComponent
            lov: @items
            displayExtraValues: true
            displayNullValue: true
            nullDisplayValue: - Pilih -
        }
        layout {
            sequence: 25
            region: @pr-lines
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @pr-lines
            column: ITEM_ID
            dataType: number
        }
    )

    pageItem P341_QTY (
        type: numberField
        label {
            label: Qty
            alignment: right
        }
        settings {
            numberAlignment: end
            virtualKeyboard: decimal
            minValue: 0
        }
        layout {
            sequence: 35
            region: @pr-lines
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @pr-lines
            column: QTY
            dataType: number
        }
    )

    pageItem P341_UNIT_PRICE (
        type: numberField
        label {
            label: Harga Satuan
            alignment: right
        }
        settings {
            numberAlignment: end
            virtualKeyboard: decimal
            minValue: 0
        }
        layout {
            sequence: 45
            region: @pr-lines
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @pr-lines
            column: UNIT_PRICE
            dataType: number
        }
        default {
            type: static
            staticValue: 0
        }
    )

    pageItem P341_LINE_AMOUNT (
        type: displayOnly
        label {
            label: Jumlah
            alignment: right
        }
        settings {
            sendOnPageSubmit: false
        }
        layout {
            sequence: 55
            region: @pr-lines
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @pr-lines
            column: LINE_AMOUNT
            dataType: number
            queryOnly: true
        }
    )

    pageItem P341_NOTES (
        type: textField
        label {
            label: Catatan
            alignment: right
        }
        layout {
            sequence: 65
            region: @pr-lines
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 60
        }
        validation {
            maxLength: 500
        }
        source {
            formRegion: @pr-lines
            column: NOTES
            dataType: varchar2
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--simple
            ]
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P341_LINE_ID is not null
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P341_LINE_ID is not null
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P341_LINE_ID is null
        }
    )

    dynamicAction on-click-cancel-close-dialog (
        name: ON_CLICK_CANCEL_CLOSE_DIALOG
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process init-pr-lines-form (
        name: INIT_PR_LINES_FORM
        type: formInitialization
        formRegion: @pr-lines
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 900341001
        }
    )

    process save-pr-lines (
        name: SAVE_PR_LINES
        type: formAutoRowProcessing
        formRegion: @pr-lines
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 900341002
        }
    )

    process close-dialog (
        name: CLOSE_DIALOG
        type: closeDialog
        settings {
            showSuccessMessages: true
        }
        execution {
            sequence: 50
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: DELETE,SAVE,CREATE
        }
        advanced {
            executionMappingIdentifier: 900341003
        }
    )

)
