page 211 (
    name: Customer
    alias: CUSTOMER
    title: Customer
    pageGroup: @master-data
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        chained: false
        resizable: true
    }
    security {
        authorizationScheme: @master-data
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region customers (
        name: Customer
        type: form
        source {
            location: localDatabase
            tableName: APX_MBMS_CUSTOMERS
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P211_CUSTOMER_ID (
        type: hidden
        layout {
            sequence: 5
            region: @customers
            slot: regionBody
        }
        source {
            formRegion: @customers
            column: CUSTOMER_ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P211_CUSTOMER_CODE (
        type: textField
        label {
            label: Kode
            alignment: right
        }
        layout {
            sequence: 15
            region: @customers
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 30
        }
        source {
            formRegion: @customers
            column: CUSTOMER_CODE
            dataType: varchar2
        }
    )

    pageItem P211_CUSTOMER_NAME (
        type: textField
        label {
            label: Nama Customer
            alignment: right
        }
        layout {
            sequence: 25
            region: @customers
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 200
        }
        source {
            formRegion: @customers
            column: CUSTOMER_NAME
            dataType: varchar2
        }
    )

    pageItem P211_NPWP (
        type: textField
        label {
            label: NPWP
            alignment: right
        }
        layout {
            sequence: 35
            region: @customers
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 30
        }
        source {
            formRegion: @customers
            column: NPWP
            dataType: varchar2
        }
    )

    pageItem P211_NITKU (
        type: textField
        label {
            label: NITKU
            alignment: right
        }
        layout {
            sequence: 45
            region: @customers
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 30
        }
        source {
            formRegion: @customers
            column: NITKU
            dataType: varchar2
        }
    )

    pageItem P211_ADDRESS (
        type: textarea
        label {
            label: Alamat
            alignment: right
        }
        layout {
            sequence: 55
            region: @customers
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 60
            height: 3
        }
        validation {
            maxLength: 500
        }
        source {
            formRegion: @customers
            column: ADDRESS
            dataType: varchar2
        }
    )

    pageItem P211_CITY (
        type: textField
        label {
            label: Kota
            alignment: right
        }
        layout {
            sequence: 65
            region: @customers
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 100
        }
        source {
            formRegion: @customers
            column: CITY
            dataType: varchar2
        }
    )

    pageItem P211_CONTACT_PERSON (
        type: textField
        label {
            label: Contact Person
            alignment: right
        }
        layout {
            sequence: 75
            region: @customers
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 100
        }
        source {
            formRegion: @customers
            column: CONTACT_PERSON
            dataType: varchar2
        }
    )

    pageItem P211_PHONE (
        type: textField
        label {
            label: Telepon
            alignment: right
        }
        layout {
            sequence: 85
            region: @customers
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 50
        }
        source {
            formRegion: @customers
            column: PHONE
            dataType: varchar2
        }
    )

    pageItem P211_EMAIL (
        type: textField
        label {
            label: Email
            alignment: right
        }
        layout {
            sequence: 95
            region: @customers
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 200
        }
        source {
            formRegion: @customers
            column: EMAIL
            dataType: varchar2
        }
    )

    pageItem P211_PAYMENT_TERM_DAYS (
        type: numberField
        label {
            label: TOP (hari)
            alignment: right
        }
        settings {
            numberAlignment: end
            virtualKeyboard: decimal
            minValue: 0
        }
        layout {
            sequence: 105
            region: @customers
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @customers
            column: PAYMENT_TERM_DAYS
            dataType: number
        }
        default {
            type: static
            staticValue: 30
        }
    )

    pageItem P211_ACTIVE_YN (
        type: selectList
        label {
            label: Aktif
            alignment: right
        }
        lov {
            type: sharedComponent
            lov: @yes-no
            displayExtraValues: true
            displayNullValue: true
            nullDisplayValue: - Pilih -
        }
        layout {
            sequence: 115
            region: @customers
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            formRegion: @customers
            column: ACTIVE_YN
            dataType: varchar2
        }
        default {
            type: static
            staticValue: Y
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--simple
            ]
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P211_CUSTOMER_ID is not null
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P211_CUSTOMER_ID is not null
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P211_CUSTOMER_ID is null
        }
    )

    dynamicAction on-click-cancel-close-dialog (
        name: ON_CLICK_CANCEL_CLOSE_DIALOG
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process init-customers-form (
        name: INIT_CUSTOMERS_FORM
        type: formInitialization
        formRegion: @customers
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 900211001
        }
    )

    process save-customers (
        name: SAVE_CUSTOMERS
        type: formAutoRowProcessing
        formRegion: @customers
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 900211002
        }
    )

    process close-dialog (
        name: CLOSE_DIALOG
        type: closeDialog
        settings {
            showSuccessMessages: true
        }
        execution {
            sequence: 50
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: DELETE,SAVE,CREATE
        }
        advanced {
            executionMappingIdentifier: 900211003
        }
    )

)
