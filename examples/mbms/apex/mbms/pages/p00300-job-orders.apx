page 300 (
    name: Job Orders
    alias: JOB-ORDERS
    title: Job Orders
    pageGroup: @printing
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @app-users
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region job-orders (
        name: Job Orders
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select job_id, job_no, job_type, customer_id_dsp, product_desc, qty_order, ups_per_sheet, insheet_pct, due_date, selling_price, est_hpp, status, updated_by, updated_on
                  from apx_mbms_job_orders_v
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 301
                items: {
                    P301_JOB_ID: \#JOB_ID#\
                }
                clearCache: 301
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: Tidak ada data.
        }
        actionsMenu {
            subscription: false
        }

        column JOB_ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 1
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        column JOB_NO (
            type: plainText
            heading {
                heading: No. Job Order
            }
            layout {
                sequence: 2
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column JOB_TYPE (
            type: plainText
            heading {
                heading: Tipe Produksi
            }
            layout {
                sequence: 3
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column CUSTOMER_ID_DSP (
            type: plainText
            heading {
                heading: Customer
            }
            layout {
                sequence: 4
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        column PRODUCT_DESC (
            type: plainText
            heading {
                heading: Produk / Spesifikasi
            }
            layout {
                sequence: 5
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        column QTY_ORDER (
            type: plainText
            heading {
                heading: Qty Order
                alignment: end
            }
            layout {
                sequence: 6
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G990D99
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: F
            }
        )

        column UPS_PER_SHEET (
            type: plainText
            heading {
                heading: Imposition (up/lembar)
                alignment: end
            }
            layout {
                sequence: 7
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: G
            }
        )

        column INSHEET_PCT (
            type: plainText
            heading {
                heading: Toleransi Insheet (%)
                alignment: end
            }
            layout {
                sequence: 8
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: H
            }
        )

        column DUE_DATE (
            type: plainText
            heading {
                heading: Due Date
            }
            layout {
                sequence: 9
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: I
            }
        )

        column SELLING_PRICE (
            type: plainText
            heading {
                heading: Harga Jual
                alignment: end
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: J
            }
        )

        column EST_HPP (
            type: plainText
            heading {
                heading: Est. HPP
                alignment: end
            }
            layout {
                sequence: 11
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: K
            }
        )

        column STATUS (
            type: plainText
            heading {
                heading: Status
            }
            layout {
                sequence: 12
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: L
            }
        )

        column UPDATED_BY (
            type: plainText
            heading {
                heading: Diubah Oleh
            }
            layout {
                sequence: 13
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: M
            }
        )

        column UPDATED_ON (
            type: plainText
            heading {
                heading: Diubah
            }
            layout {
                sequence: 14
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: N
            }
        )

        savedReport 300001 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn JOB_NO (
                sequence: 1
            )

            displayColumn JOB_TYPE (
                sequence: 2
            )

            displayColumn CUSTOMER_ID_DSP (
                sequence: 3
            )

            displayColumn PRODUCT_DESC (
                sequence: 4
            )

            displayColumn QTY_ORDER (
                sequence: 5
            )

            displayColumn UPS_PER_SHEET (
                sequence: 6
            )

            displayColumn INSHEET_PCT (
                sequence: 7
            )

            displayColumn DUE_DATE (
                sequence: 8
            )

            displayColumn SELLING_PRICE (
                sequence: 9
            )

            displayColumn EST_HPP (
                sequence: 10
            )

            displayColumn STATUS (
                sequence: 11
            )

            displayColumn UPDATED_BY (
                sequence: 12
            )

            displayColumn UPDATED_ON (
                sequence: 13
            )

            sort (
                column: JOB_NO
                sort {
                    sequence: 1
                    direction: desc
                }
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 10
            region: @job-orders
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 301
                clearCache: 301
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @printing
        }
    )

    dynamicAction on-dialog-closed-refresh-report (
        name: ON_DIALOG_CLOSED_REFRESH_REPORT
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @job-orders
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @job-orders
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)
