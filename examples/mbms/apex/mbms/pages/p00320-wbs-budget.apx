page 320 (
    name: WBS Budget
    alias: WBS-BUDGET
    title: WBS Budget
    pageGroup: @engineering
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @app-users
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region wbs (
        name: WBS Budget
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select wbs_id, project_id_dsp, wbs_code, wbs_name, cost_category, budget_amount, updated_by, updated_on
                  from apx_mbms_wbs_v
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 321
                items: {
                    P321_WBS_ID: \#WBS_ID#\
                }
                clearCache: 321
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: Tidak ada data.
        }
        actionsMenu {
            subscription: false
        }

        column WBS_ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 1
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        column PROJECT_ID_DSP (
            type: plainText
            heading {
                heading: Proyek
            }
            layout {
                sequence: 2
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column WBS_CODE (
            type: plainText
            heading {
                heading: Kode WBS
            }
            layout {
                sequence: 3
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column WBS_NAME (
            type: plainText
            heading {
                heading: Aktivitas
            }
            layout {
                sequence: 4
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        column COST_CATEGORY (
            type: plainText
            heading {
                heading: Kategori Biaya
            }
            layout {
                sequence: 5
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        column BUDGET_AMOUNT (
            type: plainText
            heading {
                heading: Budget
                alignment: end
            }
            layout {
                sequence: 6
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: F
            }
        )

        column UPDATED_BY (
            type: plainText
            heading {
                heading: Diubah Oleh
            }
            layout {
                sequence: 7
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: G
            }
        )

        column UPDATED_ON (
            type: plainText
            heading {
                heading: Diubah
            }
            layout {
                sequence: 8
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: H
            }
        )

        savedReport 320001 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn PROJECT_ID_DSP (
                sequence: 1
            )

            displayColumn WBS_CODE (
                sequence: 2
            )

            displayColumn WBS_NAME (
                sequence: 3
            )

            displayColumn COST_CATEGORY (
                sequence: 4
            )

            displayColumn BUDGET_AMOUNT (
                sequence: 5
            )

            displayColumn UPDATED_BY (
                sequence: 6
            )

            displayColumn UPDATED_ON (
                sequence: 7
            )

            sort (
                column: WBS_CODE
                sort {
                    sequence: 1
                }
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 10
            region: @wbs
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 321
                clearCache: 321
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @engineering
        }
    )

    dynamicAction on-dialog-closed-refresh-report (
        name: ON_DIALOG_CLOSED_REFRESH_REPORT
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @wbs
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @wbs
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)
