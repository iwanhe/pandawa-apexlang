page 240 (
    name: Warehouses & Locations
    alias: WAREHOUSES
    title: Warehouses & Locations
    pageGroup: @master-data
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @app-users
    }
    comments {
        comments:
            ```
            ## Purpose
            
            Daftar Warehouses & Locations (master data).
            
            ## When to Use
            
            Mencari, memfilter, dan membuka Warehouses & Locations. Create/Edit membuka form drawer di halaman 241 (warehouse).
            
            ## AI Guidance
            
            Pola list: Interactive Report dari view apx_mbms_warehouses_v (MVC: region membaca view, bukan tabel). Kolom ref tampil sebagai <KOLOM>_DSP. Hak akses list app-users, create/edit master-data.
            
            ## Source
            
            Generated dari app.yaml entities.WAREHOUSES. Ubah app.yaml lalu jalankan scripts/generate.sh; jangan edit file ini.
            ```
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region warehouses (
        name: Warehouses & Locations
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select warehouse_id, wh_code, wh_name, bu_id_dsp, location_type, active_yn, updated_by, updated_on
                  from apx_mbms_warehouses_v
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        comments {
            comments:
                ```
                Intent: Menampilkan Warehouses & Locations yang bisa dicari dan difilter.
                Pattern role: Browse list (Interactive Report).
                AI guidance: Tambah kolom lewat columns di app.yaml (list: true/false), bukan dengan mengubah query ini.
                ```
        }
        link {
            linkColumn: customTarget
            target: {
                page: 241
                items: {
                    P241_WAREHOUSE_ID: \#WAREHOUSE_ID#\
                }
                clearCache: 241
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: Tidak ada data.
        }
        actionsMenu {
            subscription: false
        }

        column WAREHOUSE_ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 1
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        column WH_CODE (
            type: plainText
            heading {
                heading: Kode
            }
            layout {
                sequence: 2
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column WH_NAME (
            type: plainText
            heading {
                heading: Nama
            }
            layout {
                sequence: 3
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column BU_ID_DSP (
            type: plainText
            heading {
                heading: Business Unit
            }
            layout {
                sequence: 4
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        column LOCATION_TYPE (
            type: plainText
            heading {
                heading: Tipe Lokasi
            }
            layout {
                sequence: 5
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        column ACTIVE_YN (
            type: plainText
            heading {
                heading: Aktif
            }
            layout {
                sequence: 6
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: F
            }
        )

        column UPDATED_BY (
            type: plainText
            heading {
                heading: Diubah Oleh
            }
            layout {
                sequence: 7
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: G
            }
        )

        column UPDATED_ON (
            type: plainText
            heading {
                heading: Diubah
            }
            layout {
                sequence: 8
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: H
            }
        )

        savedReport 240001 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn WH_CODE (
                sequence: 1
            )

            displayColumn WH_NAME (
                sequence: 2
            )

            displayColumn BU_ID_DSP (
                sequence: 3
            )

            displayColumn LOCATION_TYPE (
                sequence: 4
            )

            displayColumn ACTIVE_YN (
                sequence: 5
            )

            displayColumn UPDATED_BY (
                sequence: 6
            )

            displayColumn UPDATED_ON (
                sequence: 7
            )

            sort (
                column: WH_CODE
                sort {
                    sequence: 1
                }
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 10
            region: @warehouses
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 241
                clearCache: 241
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @master-data
        }
    )

    dynamicAction on-dialog-closed-refresh-report (
        name: ON_DIALOG_CLOSED_REFRESH_REPORT
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @warehouses
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @warehouses
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)
