page 340 (
    name: PR Lines
    alias: PR-LINES
    title: PR Lines
    pageGroup: @procurement
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @app-users
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region pr-lines (
        name: PR Lines
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select line_id, pr_id_dsp, item_id_dsp, qty, unit_price, line_amount, notes, updated_by, updated_on
                  from apx_mbms_pr_lines_v
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 341
                items: {
                    P341_LINE_ID: \#LINE_ID#\
                }
                clearCache: 341
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: Tidak ada data.
        }
        actionsMenu {
            subscription: false
        }

        column LINE_ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 1
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        column PR_ID_DSP (
            type: plainText
            heading {
                heading: No. PR
            }
            layout {
                sequence: 2
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column ITEM_ID_DSP (
            type: plainText
            heading {
                heading: Item
            }
            layout {
                sequence: 3
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column QTY (
            type: plainText
            heading {
                heading: Qty
                alignment: end
            }
            layout {
                sequence: 4
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G990D99
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: D
            }
        )

        column UNIT_PRICE (
            type: plainText
            heading {
                heading: Harga Satuan
                alignment: end
            }
            layout {
                sequence: 5
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: E
            }
        )

        column LINE_AMOUNT (
            type: plainText
            heading {
                heading: Jumlah
                alignment: end
            }
            layout {
                sequence: 6
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: F
            }
        )

        column NOTES (
            type: plainText
            heading {
                heading: Catatan
            }
            layout {
                sequence: 7
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: G
            }
        )

        column UPDATED_BY (
            type: plainText
            heading {
                heading: Diubah Oleh
            }
            layout {
                sequence: 8
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: H
            }
        )

        column UPDATED_ON (
            type: plainText
            heading {
                heading: Diubah
            }
            layout {
                sequence: 9
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: I
            }
        )

        savedReport 340001 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn PR_ID_DSP (
                sequence: 1
            )

            displayColumn ITEM_ID_DSP (
                sequence: 2
            )

            displayColumn QTY (
                sequence: 3
            )

            displayColumn UNIT_PRICE (
                sequence: 4
            )

            displayColumn LINE_AMOUNT (
                sequence: 5
            )

            displayColumn NOTES (
                sequence: 6
            )

            displayColumn UPDATED_BY (
                sequence: 7
            )

            displayColumn UPDATED_ON (
                sequence: 8
            )

            sort (
                column: NOTES
                sort {
                    sequence: 1
                }
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 10
            region: @pr-lines
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 341
                clearCache: 341
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @app-users
        }
    )

    dynamicAction on-dialog-closed-refresh-report (
        name: ON_DIALOG_CLOSED_REFRESH_REPORT
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @pr-lines
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @pr-lines
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)
