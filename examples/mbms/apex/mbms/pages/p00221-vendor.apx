page 221 (
    name: Vendor
    alias: VENDOR
    title: Vendor
    pageGroup: @master-data
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
    }
    security {
        authorizationScheme: @master-data
    }
    comments {
        comments:
            ```
            ## Purpose
            
            Form Vendor.
            
            ## When to Use
            
            Dibuka dari halaman list 220 (vendors) untuk create/edit satu record.
            
            ## AI Guidance
            
            Form pendek; simpan dengan Create/Apply Changes. Logika validasi di database (trigger/constraint).
            
            ## Source
            
            Generated dari app.yaml entities.VENDORS (form_style: drawer). Ubah app.yaml lalu jalankan scripts/generate.sh; jangan edit file ini.
            ```
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region vendors (
        name: Vendor
        type: form
        source {
            location: localDatabase
            tableName: APX_MBMS_VENDORS
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        comments {
            comments:
                ```
                Intent: Membuat dan mengubah satu record Vendor.
                Pattern role: Single-record form (drawer).
                AI guidance: Validasi bisnis ada di trigger apx_mbms_vendors_trg dan package; item ini hanya UI.
                ```
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P221_VENDOR_ID (
        type: hidden
        layout {
            sequence: 5
            region: @vendors
            slot: regionBody
        }
        source {
            formRegion: @vendors
            column: VENDOR_ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P221_VENDOR_CODE (
        type: textField
        label {
            label: Kode
            alignment: right
        }
        layout {
            sequence: 15
            region: @vendors
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 30
        }
        source {
            formRegion: @vendors
            column: VENDOR_CODE
            dataType: varchar2
        }
    )

    pageItem P221_VENDOR_NAME (
        type: textField
        label {
            label: Nama Vendor
            alignment: right
        }
        layout {
            sequence: 25
            region: @vendors
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 200
        }
        source {
            formRegion: @vendors
            column: VENDOR_NAME
            dataType: varchar2
        }
    )

    pageItem P221_VENDOR_TYPE (
        type: selectList
        label {
            label: Tipe
            alignment: right
        }
        lov {
            type: sharedComponent
            lov: @vendors-vendor-type
            displayExtraValues: true
            displayNullValue: true
            nullDisplayValue: - Pilih -
        }
        layout {
            sequence: 35
            region: @vendors
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @vendors
            column: VENDOR_TYPE
            dataType: varchar2
        }
        default {
            type: static
            staticValue: GOODS
        }
    )

    pageItem P221_NPWP (
        type: textField
        label {
            label: NPWP
            alignment: right
        }
        layout {
            sequence: 45
            region: @vendors
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 30
        }
        source {
            formRegion: @vendors
            column: NPWP
            dataType: varchar2
        }
    )

    pageItem P221_CITY (
        type: textField
        label {
            label: Kota
            alignment: right
        }
        layout {
            sequence: 55
            region: @vendors
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 100
        }
        source {
            formRegion: @vendors
            column: CITY
            dataType: varchar2
        }
    )

    pageItem P221_PHONE (
        type: textField
        label {
            label: Telepon
            alignment: right
        }
        layout {
            sequence: 65
            region: @vendors
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 50
        }
        source {
            formRegion: @vendors
            column: PHONE
            dataType: varchar2
        }
    )

    pageItem P221_PAYMENT_TERM_DAYS (
        type: numberField
        label {
            label: TOP (hari)
            alignment: right
        }
        settings {
            numberAlignment: end
            virtualKeyboard: decimal
            minValue: 0
        }
        layout {
            sequence: 75
            region: @vendors
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @vendors
            column: PAYMENT_TERM_DAYS
            dataType: number
        }
        default {
            type: static
            staticValue: 30
        }
    )

    pageItem P221_ACTIVE_YN (
        type: selectList
        label {
            label: Aktif
            alignment: right
        }
        lov {
            type: sharedComponent
            lov: @yes-no
            displayExtraValues: true
            displayNullValue: true
            nullDisplayValue: - Pilih -
        }
        layout {
            sequence: 85
            region: @vendors
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            formRegion: @vendors
            column: ACTIVE_YN
            dataType: varchar2
        }
        default {
            type: static
            staticValue: Y
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--simple
            ]
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P221_VENDOR_ID is not null
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P221_VENDOR_ID is not null
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P221_VENDOR_ID is null
        }
    )

    dynamicAction on-click-cancel-close-dialog (
        name: ON_CLICK_CANCEL_CLOSE_DIALOG
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process init-vendors-form (
        name: INIT_VENDORS_FORM
        type: formInitialization
        formRegion: @vendors
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 900221001
        }
    )

    process save-vendors (
        name: SAVE_VENDORS
        type: formAutoRowProcessing
        formRegion: @vendors
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 900221002
        }
    )

    process close-dialog (
        name: CLOSE_DIALOG
        type: closeDialog
        settings {
            showSuccessMessages: true
        }
        execution {
            sequence: 50
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: DELETE,SAVE,CREATE
        }
        advanced {
            executionMappingIdentifier: 900221003
        }
    )

)
