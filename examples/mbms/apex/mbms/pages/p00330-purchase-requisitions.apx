page 330 (
    name: Purchase Requisitions
    alias: PURCHASE-REQUISITIONS
    title: Purchase Requisitions
    pageGroup: @procurement
    appearance {
        pageTemplate: @/left-side-column
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @app-users
    }
    comments {
        comments:
            ```
            ## Purpose
            
            Daftar Purchase Requisitions (dokumen ber-approval Purchase Requisition).
            
            ## When to Use
            
            Mencari, memfilter, dan membuka Purchase Requisitions. Create/Edit membuka form modal di halaman 331 (purchase-requisition).
            
            ## AI Guidance
            
            Pola faceted search (faceted-report): facet di kolom kiri, hasil di body, dari view apx_mbms_purchase_reqs_v (MVC). Hak akses list app-users, create/edit app-users.
            
            ## Source
            
            Generated dari app.yaml entities.PURCHASE_REQS. (list_type: faceted-report) Ubah app.yaml lalu jalankan scripts/generate.sh; jangan edit file ini.
            ```
    }

    region button-bar (
        name: Purchase Requisitions
        type: staticContent
        source {
            htmlCode: <span class="u-text-body-sm u-text-muted-color"><span id="total_row_count">-</span> baris</span>
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/hero
            templateOptions: [
                #DEFAULT#
                t-HeroRegion--hideIcon
            ]
        }
        comments {
            comments:
                ```
                Intent: Judul halaman, jumlah hasil, dan tombol Create.
                Pattern role: Page header with primary action.
                ```
        }
    )

    region search (
        name: Filter
        type: facetedSearch
        source {
            filteredRegion: @results
        }
        layout {
            sequence: 10
            slot: leftColumn
        }
        appearance {
            template: @/blank-with-attributes-no-grid
            templateOptions: #DEFAULT#
        }
        comments {
            comments:
                ```
                Intent: Mempersempit Purchase Requisitions berdasarkan dimensi yang bermakna.
                Pattern role: Facets (Faceted Search).
                AI guidance: Facet otomatis dari kolom enum, yn, ref, dan status; atur dengan facet: true/false per kolom di app.yaml.
                ```
        }
        settings {
            showTotalRowCount: selector
            totalRowCountSelector: #total_row_count
        }

        facet P330_SEARCH (
            type: search
            label {
                label: Cari
            }
            layout {
                sequence: 10
            }
        )

        facet P330_STATUS (
            type: checkboxGroup
            label {
                label: Status
            }
            lov {
                type: distinctValues
            }
            layout {
                sequence: 20
            }
            listEntries {
                maxDisplayedEntries: 7
                allowToExclude: false
            }
            source {
                databaseColumn: STATUS
            }
        )

        facet P330_BU_ID_DSP (
            type: checkboxGroup
            label {
                label: Business Unit
            }
            lov {
                type: distinctValues
            }
            layout {
                sequence: 30
            }
            listEntries {
                maxDisplayedEntries: 7
                allowToExclude: false
            }
            source {
                databaseColumn: BU_ID_DSP
            }
        )

        facet P330_PURPOSE (
            type: checkboxGroup
            label {
                label: Tujuan
            }
            lov {
                type: sharedComponent
                lov: @purchase-reqs-purpose
            }
            layout {
                sequence: 40
            }
            listEntries {
                maxDisplayedEntries: 7
                allowToExclude: false
            }
            source {
                databaseColumn: PURPOSE
            }
        )

        facet P330_JOB_ID_DSP (
            type: checkboxGroup
            label {
                label: Job Order
            }
            lov {
                type: distinctValues
            }
            layout {
                sequence: 50
            }
            listEntries {
                maxDisplayedEntries: 7
                allowToExclude: false
            }
            source {
                databaseColumn: JOB_ID_DSP
            }
        )

        facet P330_PROJECT_ID_DSP (
            type: checkboxGroup
            label {
                label: Proyek
            }
            lov {
                type: distinctValues
            }
            layout {
                sequence: 60
            }
            listEntries {
                maxDisplayedEntries: 7
                allowToExclude: false
            }
            source {
                databaseColumn: PROJECT_ID_DSP
            }
        )

        facet P330_WBS_ID_DSP (
            type: checkboxGroup
            label {
                label: WBS
            }
            lov {
                type: distinctValues
            }
            layout {
                sequence: 70
            }
            listEntries {
                maxDisplayedEntries: 7
                allowToExclude: false
            }
            source {
                databaseColumn: WBS_ID_DSP
            }
        )

    )

    region results (
        name: Hasil Purchase Requisitions
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pr_id
                      ,pr_no
                      ,bu_id_dsp
                      ,pr_date
                      ,purpose
                      ,job_id_dsp
                      ,project_id_dsp
                      ,wbs_id_dsp
                      ,need_date
                      ,description
                      ,status
                      ,updated_by
                      ,updated_on
                  from apx_mbms_purchase_reqs_v
                ```
        }
        orderBy {
            type: staticValue
            orderByClause: PR_NO DESC
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noUI
            ]
        }
        comments {
            comments:
                ```
                Intent: Hasil pencarian Purchase Requisitions yang sudah difilter facet.
                Pattern role: Faceted search results (Classic Report).
                AI guidance: Klik kolom judul untuk membuka form. Kolom diambil dari columns di app.yaml.
                ```
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        messages {
            whenNoDataFound: Tidak ada data.
        }

        column PR_ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 10
            }
        )

        column PR_NO (
            reportColumnQueryId: 2
            derivedColumn: N
            type: link
            heading {
                heading: No. Purchase Requisition
            }
            layout {
                sequence: 20
            }
            link {
                target: {
                    page: 331
                    items: {
                        P331_PR_ID: #PR_ID#
                    }
                    clearCache: 331
                }
                linkText: #PR_NO#
                linkAttributes: class="u-text-bold"
            }
        )

        column BU_ID_DSP (
            reportColumnQueryId: 3
            derivedColumn: N
            type: plainText
            heading {
                heading: Business Unit
            }
            layout {
                sequence: 30
            }
        )

        column PR_DATE (
            reportColumnQueryId: 4
            derivedColumn: N
            type: plainText
            heading {
                heading: Tanggal
            }
            layout {
                sequence: 40
            }
        )

        column PURPOSE (
            reportColumnQueryId: 5
            derivedColumn: N
            type: plainText
            heading {
                heading: Tujuan
            }
            layout {
                sequence: 50
            }
        )

        column JOB_ID_DSP (
            reportColumnQueryId: 6
            derivedColumn: N
            type: plainText
            heading {
                heading: Job Order
            }
            layout {
                sequence: 60
            }
        )

        column PROJECT_ID_DSP (
            reportColumnQueryId: 7
            derivedColumn: N
            type: plainText
            heading {
                heading: Proyek
            }
            layout {
                sequence: 70
            }
        )

        column WBS_ID_DSP (
            reportColumnQueryId: 8
            derivedColumn: N
            type: plainText
            heading {
                heading: WBS
            }
            layout {
                sequence: 80
            }
        )

        column NEED_DATE (
            reportColumnQueryId: 9
            derivedColumn: N
            type: plainText
            heading {
                heading: Dibutuhkan
            }
            layout {
                sequence: 90
            }
        )

        column DESCRIPTION (
            reportColumnQueryId: 10
            derivedColumn: N
            type: plainText
            heading {
                heading: Keterangan
            }
            layout {
                sequence: 100
            }
        )

        column STATUS (
            reportColumnQueryId: 11
            derivedColumn: N
            type: plainText
            heading {
                heading: Status
            }
            layout {
                sequence: 110
            }
        )

        column UPDATED_BY (
            reportColumnQueryId: 12
            derivedColumn: N
            type: plainText
            heading {
                heading: Diubah Oleh
            }
            layout {
                sequence: 120
            }
        )

        column UPDATED_ON (
            reportColumnQueryId: 13
            derivedColumn: N
            type: plainText
            heading {
                heading: Diubah
            }
            layout {
                sequence: 130
            }
        )

    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 10
            region: @button-bar
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 331
                clearCache: 331
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @app-users
        }
    )

    dynamicAction on-dialog-closed-refresh-report (
        name: ON_DIALOG_CLOSED_REFRESH_REPORT
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @results
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @results
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)
