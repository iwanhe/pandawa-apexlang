page 330 (
    name: Purchase Requisitions
    alias: PURCHASE-REQUISITIONS
    title: Purchase Requisitions
    pageGroup: @procurement
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @app-users
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region purchase-reqs (
        name: Purchase Requisitions
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pr_id, pr_no, bu_id_dsp, pr_date, purpose, job_id_dsp, project_id_dsp, wbs_id_dsp, need_date, description, status, updated_by, updated_on
                  from apx_mbms_purchase_reqs_v
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 331
                items: {
                    P331_PR_ID: \#PR_ID#\
                }
                clearCache: 331
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: Tidak ada data.
        }
        actionsMenu {
            subscription: false
        }

        column PR_ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 1
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        column PR_NO (
            type: plainText
            heading {
                heading: No. Purchase Requisition
            }
            layout {
                sequence: 2
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column BU_ID_DSP (
            type: plainText
            heading {
                heading: Business Unit
            }
            layout {
                sequence: 3
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column PR_DATE (
            type: plainText
            heading {
                heading: Tanggal
            }
            layout {
                sequence: 4
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: D
            }
        )

        column PURPOSE (
            type: plainText
            heading {
                heading: Tujuan
            }
            layout {
                sequence: 5
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        column JOB_ID_DSP (
            type: plainText
            heading {
                heading: Job Order
            }
            layout {
                sequence: 6
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: F
            }
        )

        column PROJECT_ID_DSP (
            type: plainText
            heading {
                heading: Proyek
            }
            layout {
                sequence: 7
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: G
            }
        )

        column WBS_ID_DSP (
            type: plainText
            heading {
                heading: WBS
            }
            layout {
                sequence: 8
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: H
            }
        )

        column NEED_DATE (
            type: plainText
            heading {
                heading: Dibutuhkan
            }
            layout {
                sequence: 9
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: I
            }
        )

        column DESCRIPTION (
            type: plainText
            heading {
                heading: Keterangan
            }
            layout {
                sequence: 10
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: J
            }
        )

        column STATUS (
            type: plainText
            heading {
                heading: Status
            }
            layout {
                sequence: 11
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: K
            }
        )

        column UPDATED_BY (
            type: plainText
            heading {
                heading: Diubah Oleh
            }
            layout {
                sequence: 12
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: L
            }
        )

        column UPDATED_ON (
            type: plainText
            heading {
                heading: Diubah
            }
            layout {
                sequence: 13
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: M
            }
        )

        savedReport 330001 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn PR_NO (
                sequence: 1
            )

            displayColumn BU_ID_DSP (
                sequence: 2
            )

            displayColumn PR_DATE (
                sequence: 3
            )

            displayColumn PURPOSE (
                sequence: 4
            )

            displayColumn JOB_ID_DSP (
                sequence: 5
            )

            displayColumn PROJECT_ID_DSP (
                sequence: 6
            )

            displayColumn WBS_ID_DSP (
                sequence: 7
            )

            displayColumn NEED_DATE (
                sequence: 8
            )

            displayColumn DESCRIPTION (
                sequence: 9
            )

            displayColumn STATUS (
                sequence: 10
            )

            displayColumn UPDATED_BY (
                sequence: 11
            )

            displayColumn UPDATED_ON (
                sequence: 12
            )

            sort (
                column: PR_NO
                sort {
                    sequence: 1
                    direction: desc
                }
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 10
            region: @purchase-reqs
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 331
                clearCache: 331
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @app-users
        }
    )

    dynamicAction on-dialog-closed-refresh-report (
        name: ON_DIALOG_CLOSED_REFRESH_REPORT
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @purchase-reqs
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @purchase-reqs
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)
