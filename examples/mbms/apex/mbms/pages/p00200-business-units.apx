page 200 (
    name: Business Units
    alias: BUSINESS-UNITS
    title: Business Units
    pageGroup: @master-data
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @app-users
    }
    comments {
        comments:
            ```
            ## Purpose
            
            Daftar Business Units (master data).
            
            ## When to Use
            
            Mencari, memfilter, dan membuka Business Units. Create/Edit membuka form drawer di halaman 201 (business-unit).
            
            ## AI Guidance
            
            Pola list: Interactive Report dari view apx_mbms_business_units_v (MVC: region membaca view, bukan tabel). Kolom ref tampil sebagai <KOLOM>_DSP. Hak akses list app-users, create/edit admin-rights.
            
            ## Source
            
            Generated dari app.yaml entities.BUSINESS_UNITS. Ubah app.yaml lalu jalankan scripts/generate.sh; jangan edit file ini.
            ```
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region business-units (
        name: Business Units
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select bu_id, bu_code, bu_name, active_yn, updated_by, updated_on
                  from apx_mbms_business_units_v
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        comments {
            comments:
                ```
                Intent: Menampilkan Business Units yang bisa dicari dan difilter.
                Pattern role: Browse list (Interactive Report).
                AI guidance: Tambah kolom lewat columns di app.yaml (list: true/false), bukan dengan mengubah query ini.
                ```
        }
        link {
            linkColumn: customTarget
            target: {
                page: 201
                items: {
                    P201_BU_ID: \#BU_ID#\
                }
                clearCache: 201
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: Tidak ada data.
        }
        actionsMenu {
            subscription: false
        }

        column BU_ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 1
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        column BU_CODE (
            type: plainText
            heading {
                heading: Kode BU
            }
            layout {
                sequence: 2
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column BU_NAME (
            type: plainText
            heading {
                heading: Nama BU
            }
            layout {
                sequence: 3
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column ACTIVE_YN (
            type: plainText
            heading {
                heading: Aktif
            }
            layout {
                sequence: 4
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        column UPDATED_BY (
            type: plainText
            heading {
                heading: Diubah Oleh
            }
            layout {
                sequence: 5
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        column UPDATED_ON (
            type: plainText
            heading {
                heading: Diubah
            }
            layout {
                sequence: 6
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: F
            }
        )

        savedReport 200001 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn BU_CODE (
                sequence: 1
            )

            displayColumn BU_NAME (
                sequence: 2
            )

            displayColumn ACTIVE_YN (
                sequence: 3
            )

            displayColumn UPDATED_BY (
                sequence: 4
            )

            displayColumn UPDATED_ON (
                sequence: 5
            )

            sort (
                column: BU_CODE
                sort {
                    sequence: 1
                }
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 10
            region: @business-units
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 201
                clearCache: 201
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @admin-rights
        }
    )

    dynamicAction on-dialog-closed-refresh-report (
        name: ON_DIALOG_CLOSED_REFRESH_REPORT
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @business-units
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @business-units
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)
