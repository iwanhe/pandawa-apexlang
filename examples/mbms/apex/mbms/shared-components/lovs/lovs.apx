lov yes-no (
    name: YES_NO
    source {
        location: staticValues
    }

    entry y (
        sequence: 10
        display: Ya
        return: Y
    )

    entry n (
        sequence: 20
        display: Tidak
        return: N
    )

)

lov roles (
    name: MBMS_ROLES
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select role_code || ' - ' || role_name d, role_code r
              from apx_mbms_roles
             order by role_code
            ```
    }
    columnMapping {
        return: R
        display: D
    }
)

lov business-units (
    name: APX_MBMS_BUSINESS_UNITS
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select bu_code || ' - ' || bu_name d, bu_id r
              from apx_mbms_business_units
             where active_yn = 'Y'
             order by 1
            ```
    }
    columnMapping {
        return: R
        display: D
    }
)

