lov job-orders (
    name: APX_MBMS_JOB_ORDERS
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select job_no || ' - ' || substr(product_desc, 1, 60) d, job_id r
              from apx_mbms_job_orders
             where status in ('APPROVED', 'IN_PROGRESS', 'COMPLETED')
             order by 1
            ```
    }
    columnMapping {
        return: R
        display: D
    }
)

